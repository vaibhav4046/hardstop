//! The adversary: a seeded attacker that tries to get money out of the kernel.
//!
//! `campaign` plays many random games. In each game an agent fires hostile
//! requests (over the cap, one unit over, replayed, from a stranger, to an
//! unapproved recipient, zero, enormous) while time jumps around window
//! edges and the owner keeps amending the rules. After every request the
//! verdict is checked against `spec_allows`, a second, independent statement
//! of the rules, and against the exposure bound computed at the start of the
//! game.
//!
//! Like the kernel, this module is pure and compiles for both targets, so
//! the same games run under `fe test` on the EVM and natively. Everything is
//! derived from the seed: a failing game is reproduced by its seed and case
//! number.
//!
//! The engine under attack is a type parameter. Tests point the same
//! campaign at deliberately broken engines and require it to catch each one.

use ingot::kernel::{
    amend,
    cancel,
    decide,
    exposure,
    left_in_window,
    Decision,
    Ledger,
    Policy,
    Queued,
    Request,
    Rules,
    Schedule,
}

/// Something that decides requests. The real kernel, or a broken copy of it.
pub trait Engine {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: u64) -> Decision
}

/// The real kernel.
pub struct Kernel {}

impl Engine for Kernel {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: u64) -> Decision {
        decide(rules, ledger, request, now)
    }
}

/// SplitMix64. Small, fast, and identical on every target.
pub struct Rng { state: u64 }

impl Rng {
    pub fn new(_ seed: u64) -> Rng {
        Rng { state: seed }
    }

    pub fn next(mut self) -> u64 {
        self.state = self.state.wrapping_add(0x9e3779b97f4a7c15)
        var z = self.state
        z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9)
        z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb)
        z ^ (z >> 31)
    }

    /// A number in `0..n`. `n` must not be zero.
    pub fn below(mut self, _ n: u64) -> u64 {
        self.next() % n
    }

    /// True once in `n` calls on average.
    pub fn one_in(mut self, _ n: u64) -> bool {
        self.next() % n == 0
    }
}

/// What went wrong, if anything. `0` means every check held.
pub const OK: u8 = 0
/// Allowed something the spec refuses.
pub const ALLOWED_WRONGLY: u8 = 1
/// Refused something the spec allows.
pub const DENIED_WRONGLY: u8 = 2
/// Allowed, but the ledger it returned is not the old one plus the payment.
pub const BAD_LEDGER: u8 = 3
/// More left the vault than the exposure bound promised.
pub const OVER_EXPOSURE: u8 = 4
/// A refusal carried a code outside the documented range.
pub const BAD_CODE: u8 = 5

pub struct Report {
    pub cases: u64,
    pub requests: u64,
    pub allowed: u64,
    pub denied: u64,
    /// One of the constants above.
    pub violation: u8,
    /// Case and step of the first violation.
    pub at_case: u64,
    pub at_step: u64,
    /// Fingerprint of every verdict, in order. Two targets that agree on
    /// every verdict produce the same digest.
    pub digest: u64,
}

impl Copy for Report {}

/// The rules, stated a second time and in a different shape from `decide`:
/// one conjunction instead of an ordered chain of early returns.
pub fn spec_allows(rules: Rules, ledger: Ledger, request: Request, now: u64) -> bool {
    let schedule = rules.schedule
    if schedule.window_secs == 0 || now < schedule.anchor {
        return false
    }
    let policy = rules.current(now)
    let window = (now - schedule.anchor) / schedule.window_secs
    let spent: u256 = if window == ledger.window {
        ledger.spent
    } else {
        0
    }
    !policy.paused
        && request.from_agent
        && request.to_approved
        && now <= policy.valid_until
        && request.nonce == ledger.next_nonce
        && ledger.next_nonce != 18446744073709551615
        && request.amount != 0
        && request.amount <= policy.per_payment
        && request.amount <= left_in_window(policy, spent)
}

fn mix(_ digest: u64, _ value: u64) -> u64 {
    (digest ^ value).wrapping_mul(0x100000001b3)
}

fn pick_window(_ rng: mut Rng) -> u64 {
    let roll = rng.below(4)
    if roll == 0 {
        1
    } else if roll == 1 {
        60
    } else if roll == 2 { 3600 } else { 86400 }
}

fn pick_policy(_ rng: mut Rng, around: u64, window_secs: u64) -> Policy {
    Policy {
        per_payment: if rng.one_in(12) {
            0
        } else {
            (1 + rng.below(50)) as u256
        },
        per_window: rng.below(160) as u256,
        valid_until: around + rng.below(40) * window_secs + rng.below(window_secs),
        paused: rng.one_in(16),
    }
}

fn pick_amount(_ rng: mut Rng, _ policy: Policy, left: u256) -> u256 {
    let roll = rng.below(10)
    let most = if policy.per_payment < left {
        policy.per_payment
    } else {
        left
    }
    if roll < 3 {
        // Exactly as much as is allowed.
        most
    } else if roll < 5 {
        // One unit too many.
        most + 1
    } else if roll == 5 {
        0
    } else if roll == 6 {
        // Everything.
        115792089237316195423570985008687907853269984665640564039457584007913129639935
    } else {
        // Somewhere around the cap.
        let cap: u64 = policy.per_payment.downcast_saturate()
        (1 + rng.below(cap + 3)) as u256
    }
}

fn pick_step(_ rng: mut Rng, window_secs: u64, now: u64, anchor: u64) -> u64 {
    let roll = rng.below(8)
    if roll < 3 {
        0
    } else if roll < 5 {
        1 + rng.below(3)
    } else if roll == 5 && now >= anchor {
        // Land on the last second of this window, or the first of the next.
        let into = (now - anchor) % window_secs
        window_secs - into - 1 + rng.below(2)
    } else if roll == 6 {
        rng.below(window_secs + 1)
    } else {
        rng.below(3 * window_secs + 1)
    }
}

/// Play `cases` games of `steps` requests each against engine `E`.
pub fn campaign<E: Engine>(seed: u64, cases: u64, steps: u64) -> Report {
    var report = Report {
        cases,
        requests: 0,
        allowed: 0,
        denied: 0,
        violation: OK,
        at_case: 0,
        at_step: 0,
        digest: 0xcbf29ce484222325,
    }

    var case: u64 = 0
    while case < cases {
        var rng = Rng::new(seed.wrapping_add(case.wrapping_mul(0x2545f4914f6cdd1d)))
        let window_secs = pick_window(mut rng)
        let cooling_roll = rng.below(3)
        let cooling_secs: u64 = if cooling_roll == 0 {
            30
        } else if cooling_roll == 1 { 3600 } else { 86400 }
        let anchor = 1000000 + rng.below(1000)
        var rules = Rules {
            schedule: Schedule { anchor, window_secs, cooling_secs },
            active: pick_policy(mut rng, around: anchor, window_secs),
            queued: Queued::none(),
        }
        var ledger = Ledger { window: 0, spent: 0, next_nonce: 0 }
        // One game in eight starts before the schedule does.
        var now = if rng.one_in(8) {
            anchor - 1 - rng.below(5)
        } else {
            anchor + rng.below(window_secs)
        }

        // The promise under test: from here until the cooling period would
        // end, no more than `bound` leaves, whatever happens.
        let until = now + cooling_secs - 1
        let bound = exposure(rules, ledger, now, until)
        var paid: u256 = 0

        var step: u64 = 0
        while step < steps {
            now = now + pick_step(mut rng, window_secs, now, anchor)

            // The owner changes its mind now and then.
            let owner = rng.below(12)
            if owner == 0 {
                rules = amend(
                    rules,
                    proposed: pick_policy(mut rng, around: now, window_secs),
                    now,
                )
            } else if owner == 1 {
                rules = cancel(rules, now)
            }

            let policy = rules.current(now)
            let in_window = now >= anchor && (now - anchor) / window_secs == ledger.window
            let spent: u256 = if in_window { ledger.spent } else { 0 }
            let nonce_roll = rng.below(16)
            let nonce = if nonce_roll == 0 && ledger.next_nonce > 0 {
                // Replay the last payment.
                ledger.next_nonce - 1
            } else if nonce_roll == 1 {
                ledger.next_nonce + 1 + rng.below(3)
            } else {
                ledger.next_nonce
            }
            let request = Request {
                amount: pick_amount(mut rng, policy, left: left_in_window(policy, spent)),
                nonce,
                from_agent: !rng.one_in(20),
                to_approved: !rng.one_in(16),
            }

            let expected = spec_allows(rules, ledger, request, now)
            let decision = E::decide(rules, ledger, request, now)
            report.requests = report.requests + 1
            report.digest = mix(mix(report.digest, decision.code() as u64), now)

            var violation = OK
            match decision {
                Decision::Allow(next) => {
                    report.allowed = report.allowed + 1
                    if !expected {
                        violation = ALLOWED_WRONGLY
                    } else if next.next_nonce != ledger.next_nonce + 1
                        || next.window != (now - anchor) / window_secs
                        || next.spent != spent + request.amount {
                        violation = BAD_LEDGER
                    }
                    if now <= until {
                        paid = paid.saturating_add(request.amount)
                        if violation == OK && paid > bound {
                            violation = OVER_EXPOSURE
                        }
                    }
                    ledger = next
                },
                Decision::Deny(reason) => {
                    report.denied = report.denied + 1
                    if expected {
                        violation = DENIED_WRONGLY
                    } else if reason.code() == 0 || reason.code() > 11 {
                        violation = BAD_CODE
                    }
                },
            }

            if violation != OK && report.violation == OK {
                report.violation = violation
                report.at_case = case
                report.at_step = step
            }
            step = step + 1
        }
        case = case + 1
    }
    report
}

/// A greedy agent: every second it can, it takes as much as it is allowed.
/// Returns what it got between `now` and `until`. With nothing queued this
/// equals `exposure`, which is what makes the bound exact rather than loose.
pub fn greedy_take(rules: Rules, ledger: Ledger, now: u64, until: u64, stride: u64) -> u256 {
    var ledger = ledger
    var taken: u256 = 0
    var at = now
    while at <= until {
        var more = true
        while more {
            let policy = rules.current(now: at)
            let in_window = at >= rules.schedule.anchor
                && rules.schedule.window_secs != 0
                && (at - rules.schedule.anchor) / rules.schedule.window_secs == ledger.window
            let spent: u256 = if in_window { ledger.spent } else { 0 }
            let left = left_in_window(policy, spent)
            let amount = if policy.per_payment < left {
                policy.per_payment
            } else {
                left
            }
            let request = Request {
                amount,
                nonce: ledger.next_nonce,
                from_agent: true,
                to_approved: true,
            }
            match decide(rules, ledger, request, now: at) {
                Decision::Allow(next) => {
                    ledger = next
                    taken = taken + amount
                },
                Decision::Deny(_) => {
                    more = false
                },
            }
        }
        if until - at < stride {
            at = until + 1
        } else {
            at = at + stride
        }
    }
    taken
}
