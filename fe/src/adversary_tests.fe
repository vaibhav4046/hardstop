//! Runs the adversary against the real kernel and against broken copies of
//! it. No `#[cfg]` on the tests: they run on the EVM and natively. Only the
//! campaign size differs, because native code is far faster.

use ingot::adversary::{
    campaign,
    greedy_take,
    Engine,
    Kernel,
    ALLOWED_WRONGLY,
    BAD_LEDGER,
    DENIED_WRONGLY,
    OK,
    OVER_EXPOSURE,
}
use ingot::kernel::{
    amend,
    decide,
    exposure,
    loosens,
    Decision,
    Instant,
    Ledger,
    OwnerProof,
    Policy,
    Queued,
    Reason,
    Request,
    Rules,
    Schedule,
    Seconds,
}

const SEED: u64 = 0x4841524453544f50

#[cfg(target = "evm")]
const CASES: u64 = 300
#[cfg(target = "native")]
const CASES: u64 = 20000

const STEPS: u64 = 40

// --- the real kernel ------------------------------------------------------

#[test]
fn the_kernel_survives_the_campaign() {
    let report = campaign<Kernel>(seed: SEED, cases: CASES, steps: STEPS)
    assert!(report.violation == OK)
    assert!(report.requests == CASES * STEPS)
    // The games are not trivial: plenty of each outcome.
    assert!(report.allowed * 8 > report.requests)
    assert!(report.denied * 4 > report.requests)
}

/// The exposure promise is only worth checking if the campaign takes it in
/// interesting states and the agent actually pushes against it.
#[test]
fn the_campaign_presses_on_the_exposure_bound() {
    let report = campaign<Kernel>(seed: SEED, cases: 200, steps: STEPS)
    assert!(report.violation == OK)
    // Taken many times per game, not once.
    assert!(report.promises > 200 * 10)
    // Taken while a raise was waiting, and with money already spent.
    assert!(report.promises_with_queue * 20 > report.promises)
    assert!(report.promises_with_spend * 20 > report.promises)
    // And the agent took every last unit of it, in at least one promise in fifty.
    assert!(report.promises_reached * 50 > report.promises)
}

/// The same 200 games on both targets must produce the same fingerprint of
/// verdicts. If the EVM build and the native build ever disagreed on a
/// single request, one of the two runs would fail here.
#[test]
fn both_targets_reach_the_same_verdicts() {
    let report = campaign<Kernel>(seed: SEED, cases: 200, steps: STEPS)
    assert!(report.violation == OK)
    assert!(report.requests == 8000)
    assert!(report.allowed == 1745)
    assert!(report.digest == 885356084767103301)
}

#[test]
fn a_greedy_agent_gets_exactly_the_exposure_bound() {
    let rules = Rules {
        schedule: Schedule {
            anchor: Instant::at(1000),
            window_secs: Seconds::of(60),
            cooling_secs: Seconds::of(3600),
        },
        active: Policy {
            per_payment: 7,
            per_window: 20,
            valid_until: Instant::at(1000 + 400),
            paused: false,
        },
        queued: Queued::none(),
    }
    let used = Ledger { window: 0, spent: 5, next_nonce: 3 }
    // Seven windows, the first already 5 into its 20.
    let bound = exposure(
        rules,
        ledger: used,
        now: Instant::at(1010),
        until: Instant::at(1400),
    )
    assert!(bound == 15 + 6 * 20)
    assert!(
        greedy_take(rules, ledger: used, now: 1010, until: 1400, stride: 1) == bound,
    )
    // Stopping early or starting late only lowers the bound.
    assert!(
        greedy_take(rules, ledger: used, now: 1010, until: 1059, stride: 1) == 15,
    )
    assert!(
        exposure(
                rules,
                ledger: used,
                now: Instant::at(1010),
                until: Instant::at(1059),
            ) == 15,
    )
}

// --- broken kernels the campaign must catch --------------------------------
//
// Each one differs from the real kernel in a single way. A test passes only
// if the campaign reports a violation, and of the expected kind.

/// Lets a payment through that is one unit over the single-payment cap.
struct OneOverCap {}

impl Engine for OneOverCap {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        var loose = rules
        loose.active.per_payment = loose.active.per_payment + 1
        loose.queued.policy.per_payment = loose.queued.policy.per_payment + 1
        decide(rules: loose, ledger, request, now)
    }
}

/// Forgets what was already spent in the window.
struct ForgetsSpending {}

impl Engine for ForgetsSpending {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        let blank = Ledger { window: ledger.window, spent: 0, next_nonce: ledger.next_nonce }
        decide(rules, ledger: blank, request, now)
    }
}

/// Accepts any sequence number, so a request can be replayed.
struct AcceptsReplays {}

impl Engine for AcceptsReplays {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        let forged = Request {
            amount: request.amount,
            nonce: ledger.next_nonce,
            from_agent: request.from_agent,
            to_approved: request.to_approved,
        }
        decide(rules, ledger, request: forged, now)
    }
}

/// Ignores the pause switch.
struct IgnoresPause {}

impl Engine for IgnoresPause {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        var running = rules
        running.active.paused = false
        running.queued.policy.paused = false
        decide(rules: running, ledger, request, now)
    }
}

/// Applies a queued raise at once instead of after the cooling period.
struct SkipsCooling {}

impl Engine for SkipsCooling {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        var eager = rules
        if eager.queued.is_some() {
            eager.active = eager.queued.policy
        }
        decide(rules: eager, ledger, request, now)
    }
}

/// Lets a queued raise take effect one second early.
struct OneSecondEarly {}

impl Engine for OneSecondEarly {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        var early = rules
        if early.queued.effective_at > Instant::at(1) {
            early.queued.effective_at = early.queued.effective_at - Seconds::of(1)
        }
        decide(rules: early, ledger, request, now)
    }
}

/// Pays anyone, approved or not.
struct PaysAnyone {}

impl Engine for PaysAnyone {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        let forged = Request {
            amount: request.amount,
            nonce: request.nonce,
            from_agent: true,
            to_approved: true,
        }
        decide(rules, ledger, request: forged, now)
    }
}

/// Refuses a payment of exactly the cap.
struct TooStrict {}

impl Engine for TooStrict {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        if request.amount == rules.current(now).per_payment {
            Decision::Deny(Reason::OverPaymentLimit(request.amount))
        } else {
            decide(rules, ledger, request, now)
        }
    }
}

/// Counts a payment at half its size.
struct UnderCounts {}

impl Engine for UnderCounts {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        match decide(rules, ledger, request, now) {
            Decision::Allow(next) => Decision::Allow(
                Ledger {
                    window: next.window,
                    spent: next.spent - request.amount / 2,
                    next_nonce: next.next_nonce,
                },
            ),
            Decision::Deny(reason) => Decision::Deny(reason),
        }
    }
}

/// Promises half of what can actually leave.
struct UnderstatesExposure {}

impl Engine for UnderstatesExposure {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        decide(rules, ledger, request, now)
    }

    fn exposure(rules: Rules, ledger: Ledger, now: Instant, until: Instant) -> u256 {
        exposure(rules, ledger, now, until) / 2
    }
}

/// Computes the bound as if no raise were waiting.
struct ExposureForgetsQueue {}

impl Engine for ExposureForgetsQueue {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        decide(rules, ledger, request, now)
    }

    fn exposure(rules: Rules, ledger: Ledger, now: Instant, until: Instant) -> u256 {
        let unqueued = Rules {
            schedule: rules.schedule,
            active: rules.active,
            queued: Queued::none(),
        }
        exposure(rules: unqueued, ledger, now, until)
    }
}

/// Takes spending from an older window off the bound for the current one.
struct ExposureCountsStaleSpend {}

impl Engine for ExposureCountsStaleSpend {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        decide(rules, ledger, request, now)
    }

    fn exposure(rules: Rules, ledger: Ledger, now: Instant, until: Instant) -> u256 {
        var stale = ledger
        if now >= rules.schedule.anchor && rules.schedule.window_secs != Seconds::of(0) {
            stale.window = (now - rules.schedule.anchor) / rules.schedule.window_secs
        }
        exposure(rules, ledger: stale, now, until)
    }
}

/// Applies a raise the moment it is proposed.
struct AmendSkipsCooling {}

impl Engine for AmendSkipsCooling {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        decide(rules, ledger, request, now)
    }

    fn amend(_ proof: own OwnerProof, rules: Rules, proposed: Policy, now: Instant) -> Rules {
        if loosens(rules.current(now), to: proposed) {
            Rules { schedule: rules.schedule, active: proposed, queued: Queued::none() }
        } else {
            amend(proof, rules, proposed, now)
        }
    }
}

/// When a raise is already waiting, a new and bigger one inherits its
/// place in the queue instead of starting its own wait.
struct AmendKeepsOldMaturity {}

impl Engine for AmendKeepsOldMaturity {
    fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
        decide(rules, ledger, request, now)
    }

    fn amend(_ proof: own OwnerProof, rules: Rules, proposed: Policy, now: Instant) -> Rules {
        var next = amend(proof, rules, proposed, now)
        if rules.queued.is_some() && !rules.queued.matured(now) && next.queued.is_some() {
            next.queued.effective_at = rules.queued.effective_at
        }
        next
    }
}

#[test]
fn catches_a_kernel_that_is_one_over_the_cap() {
    assert!(
        campaign<OneOverCap>(seed: SEED, cases: 200, steps: STEPS).violation == ALLOWED_WRONGLY,
    )
}

#[test]
fn catches_a_kernel_that_forgets_spending() {
    assert!(
        campaign<ForgetsSpending>(seed: SEED, cases: 200, steps: STEPS).violation != OK,
    )
}

#[test]
fn catches_a_kernel_that_accepts_replays() {
    assert!(
        campaign<AcceptsReplays>(seed: SEED, cases: 200, steps: STEPS).violation == ALLOWED_WRONGLY,
    )
}

#[test]
fn catches_a_kernel_that_ignores_pause() {
    assert!(
        campaign<IgnoresPause>(seed: SEED, cases: 200, steps: STEPS).violation == ALLOWED_WRONGLY,
    )
}

#[test]
fn catches_a_kernel_that_skips_cooling() {
    assert!(
        campaign<SkipsCooling>(seed: SEED, cases: 200, steps: STEPS).violation != OK,
    )
}

#[test]
fn catches_a_raise_that_lands_one_second_early() {
    assert!(
        campaign<OneSecondEarly>(seed: SEED, cases: 200, steps: STEPS).violation != OK,
    )
}

#[test]
fn catches_a_kernel_that_pays_anyone() {
    assert!(
        campaign<PaysAnyone>(seed: SEED, cases: 200, steps: STEPS).violation == ALLOWED_WRONGLY,
    )
}

#[test]
fn catches_a_kernel_that_is_too_strict() {
    assert!(
        campaign<TooStrict>(seed: SEED, cases: 200, steps: STEPS).violation == DENIED_WRONGLY,
    )
}

#[test]
fn catches_a_kernel_that_under_counts() {
    assert!(
        campaign<UnderCounts>(seed: SEED, cases: 200, steps: STEPS).violation == BAD_LEDGER,
    )
}

#[test]
fn catches_an_exposure_bound_that_is_too_low() {
    assert!(
        campaign<UnderstatesExposure>(seed: SEED, cases: 200, steps: STEPS).violation
            == OVER_EXPOSURE,
    )
}

#[test]
fn catches_an_exposure_bound_that_forgets_a_waiting_raise() {
    assert!(
        campaign<ExposureForgetsQueue>(seed: SEED, cases: 200, steps: STEPS).violation
            == OVER_EXPOSURE,
    )
}

#[test]
fn catches_an_exposure_bound_that_counts_stale_spending() {
    assert!(
        campaign<ExposureCountsStaleSpend>(seed: SEED, cases: 200, steps: STEPS).violation
            == OVER_EXPOSURE,
    )
}

#[test]
fn catches_a_raise_applied_without_waiting() {
    assert!(
        campaign<AmendSkipsCooling>(seed: SEED, cases: 200, steps: STEPS).violation
            == OVER_EXPOSURE,
    )
}

#[test]
fn catches_a_raise_that_jumps_the_queue() {
    assert!(
        campaign<AmendKeepsOldMaturity>(seed: SEED, cases: 200, steps: STEPS).violation
            == OVER_EXPOSURE,
    )
}
