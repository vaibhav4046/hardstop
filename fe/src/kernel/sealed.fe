//! What a vault on the EVM holds, sealed so that only the kernel can make it.
//!
//! The pure kernel works on plain values: anyone can build a `Rules`, and
//! `authorize` hands an `OwnerProof` to whoever passes it the same value
//! twice. That is what the tests, the adversary and the native tool need. A
//! vault must not have that freedom, so it does not store a `Rules` and its
//! kernel calls do not take an `OwnerProof`. It stores the types below, whose
//! fields are private to this module tree, so no other module can build one,
//! read a field or write one (the compiler refuses all three as "not
//! visible").
//!
//! - `Terms` wraps the rules. New `Terms` come only from `open` and from
//!   `Terms::amend`, `cancel` and `pause`, which run the kernel's own
//!   `amend` and `cancel`: a loosening waits out the cooling period.
//! - `Owner` is the address allowed to change them. It comes only from
//!   `open`.
//! - `OwnerCall` is what `amend`, `cancel`, `pause` and `approve_from` ask
//!   for. It comes only from `prove`, which compares an `Owner` with the
//!   caller read from an `Evm`. `Evm` is a concrete type whose methods read
//!   the EVM itself, so a stand-in that implements `Ctx` cannot be passed.
//! - `Approval` is when a recipient may be paid. New ones come only from
//!   `founding`, for the recipients a vault is created with, and from
//!   `Terms::approve_from`, which runs the kernel's `approve_from`: a new
//!   recipient waits out the cooling period.
//!
//! Three checks here run when the code runs, not when it compiles: `open`
//! and `founding` refuse unless the contract is still being deployed (its
//! code size is zero); a `Terms` or `Owner` read from storage nobody wrote
//! (all zeros) does nothing: `prove` refuses the zero owner, and `amend`,
//! `cancel` and `pause` leave zeroed terms as they are; and an `Approval`
//! names the address it was made for, so one copied under another address
//! approves no one.
#![cfg(target = "evm")]

use std::evm::{Address, Call, Ctx, Evm}
use std::evm::erc20::safe_transfer
use super::{
    amend,
    approve_from,
    cancel,
    cooled,
    decide,
    Decision,
    Ledger,
    matures_at,
    Reason,
    Request,
    Instant,
    NOT_SET,
    OwnerProof,
    Policy,
    Queued,
    Rules,
    Schedule,
    Seconds,
}

/// The address allowed to change a vault's rules.
pub struct Owner { address: Address }

/// A vault's rules, as only the kernel can change them.
pub struct Terms { rules: Rules }

/// Evidence that the current call comes from the `Owner` it was proved
/// against, and the chain's time when it was proved. Like `OwnerProof`: not
/// `Copy`, spent by its first use, and a proof that is made and dropped is
/// refused. The time is read from the concrete `Evm` by `prove` and its
/// field is private, so the functions below cannot be given any other time.
#[must_use]
pub struct OwnerCall { granted: bool, now: Instant }

/// The moment from which `who` may be paid. Second zero, which is also
/// what storage nobody wrote holds, means not approved.
pub struct Approval { who: Address, from: Instant }

/// The agent's key, and a replacement the owner named that takes over at
/// `from`. Not `Copy`, and changed only in place by `Seat::replace`, so an
/// old seat cannot be kept aside and put back.
pub struct Seat { agent: Address, next: Address, from: Instant }

/// What the agent has spent, as only a payment the kernel allowed changes
/// it, and the token the vault pays in, fixed when the vault is created.
pub struct Books { ledger: Ledger, token: Address }

/// The vault's rules as they are stored, read out so a payment can be judged
/// against them. Only `Terms::now` makes one; nothing else can build it.
pub struct TermsNow { rules: Rules }

/// The key that may pay at the moment it was read. Only `Seat::now` makes one.
pub struct AgentNow { agent: Address }

/// Who is calling, and the chain's time, read from the concrete `Evm`. Only
/// `moment` makes one, so a payment cannot be judged as another caller or at
/// another time.
pub struct Moment { caller: Address, now: Instant }

/// A payment the kernel allowed: this token, to this recipient, this much.
/// Only `Books::judge` makes one, and only `send` spends it.
#[must_use]
pub struct Payout { token: Address, to: Address, amount: u256 }

/// What `Books::judge` answers.
pub enum Verdict {
    Pay(Payout),
    Refuse(Reason),
}

impl Copy for Owner {}
impl Copy for TermsNow {}
impl Copy for AgentNow {}
impl Copy for Moment {}

/// The caller and the time of the current call.
pub fn moment(_ ctx: Evm) -> Moment {
    Moment {
        caller: ctx.caller(),
        now: Instant::at(ctx.timestamp().as_seconds().downcast_saturate()),
    }
}
impl Copy for Approval {}

impl Approval {
    /// The moment from which `who` may be paid: second zero (not approved)
    /// unless this approval was made for `who`.
    pub fn of(self, _ who: Address) -> Instant {
        if self.who == who { self.from } else { NOT_SET }
    }
}

impl Owner {
    pub fn address(self) -> Address {
        self.address
    }
}

/// The owner and the first rules of a contract that is being deployed:
/// `policy` in force from the start, nothing queued. `None` once the
/// contract has code (that is, after its constructor), or when `owner` is
/// the zero address or the window is zero long.
pub fn open(
    _ ctx: Evm,
    owner: Address,
    agent: Address,
    token: Address,
    schedule: Schedule,
    policy: Policy,
) -> Option<(Owner, Seat, Terms, Books)> {
    if ctx.extcodesize(ctx.address()) != 0
        || owner == Address::zero()
        || agent == Address::zero()
        || token == Address::zero()
        || agent == owner
        || schedule.window_secs == Seconds::of(0) {
        return Option::None
    }
    let rules = Rules { schedule, active: policy, queued: Queued::none() }
    Option::Some(
        (
            Owner { address: owner },
            Seat { agent, next: Address::zero(), from: NOT_SET },
            Terms { rules },
            Books { ledger: Ledger { window: 0, spent: 0, next_nonce: 0 }, token },
        ),
    )
}

/// `who` approved from now, for a recipient the vault is created with.
/// `None` once the contract has code, as for `open`.
pub fn founding(_ ctx: Evm, who: Address) -> Option<Approval> {
    if ctx.extcodesize(ctx.address()) != 0 {
        return Option::None
    }
    let now = Instant::at(ctx.timestamp().as_seconds().downcast_saturate())
    Option::Some(Approval { who, from: now })
}

/// An `OwnerCall` when the caller of the current call is `owner`,
/// carrying the chain's time.
pub fn prove(_ owner: Owner, ctx: Evm) -> Option<OwnerCall> {
    if owner.address != Address::zero() && ctx.caller() == owner.address {
        let now = Instant::at(ctx.timestamp().as_seconds().downcast_saturate())
        Option::Some(OwnerCall { granted: true, now })
    } else {
        Option::None
    }
}

/// The kernel's proof, for the kernel's own functions. Only made from an
/// `OwnerCall`, which this spends.
fn kernel_proof(_ call: own OwnerCall) -> OwnerProof {
    OwnerProof { granted: call.granted }
}

impl Terms {
    pub fn rules(self) -> Rules {
        self.rules
    }

    /// The rules as stored, sealed, for `Books::judge`.
    pub fn now(self) -> TermsNow {
        TermsNow { rules: self.rules }
    }

    /// Zeroed storage, not something `open` made.
    fn blank(self) -> bool {
        self.rules.schedule.window_secs == Seconds::of(0)
    }

    /// The kernel's `amend`, at the time the proof carries.
    pub fn amend(mut self, _ proof: own OwnerCall, proposed: Policy) {
        let now = proof.now
        let proof = kernel_proof(proof)
        if !self.blank() {
            self.rules = amend(proof, rules: self.rules, proposed, now)
        }
    }

    /// The kernel's `cancel`, at the time the proof carries.
    pub fn cancel(mut self, _ proof: own OwnerCall) {
        let now = proof.now
        let proof = kernel_proof(proof)
        if !self.blank() {
            self.rules = cancel(proof, rules: self.rules, now)
        }
    }

    /// The policy in force, paused, applied at once; anything queued is
    /// dropped.
    pub fn pause(mut self, _ proof: own OwnerCall) {
        var stopped = self.rules.current(now: proof.now)
        stopped.paused = true
        self.amend(proof, proposed: stopped)
    }

    /// The kernel's `approve_from` for `who`, with this vault's schedule,
    /// at the time the proof carries. `current` is what is stored for `who` now.
    pub fn approve_from(
        self,
        _ proof: own OwnerCall,
        who: Address,
        current: Approval,
        approved: bool,
    ) -> Approval {
        let now = proof.now
        let proof = kernel_proof(proof)
        if self.blank() {
            return current
        }
        let from = approve_from(
            proof,
            self.rules.schedule,
            current: current.of(who),
            approved,
            now,
        )
        Approval { who, from }
    }
}

impl Seat {
    /// The key that may pay now, read at the chain's time.
    pub fn now(self, _ ctx: Evm) -> AgentNow {
        AgentNow {
            agent: self.agent_at(
                now: Instant::at(ctx.timestamp().as_seconds().downcast_saturate()),
            ),
        }
    }

    /// The key that may pay at `now`: the replacement once its moment has
    /// come, the zero address (no one) while it waits.
    pub fn agent_at(self, now: Instant) -> Address {
        if self.next != Address::zero() && cooled(at: self.from, now) {
            self.next
        } else {
            self.agent
        }
    }

    /// The replacement waiting, and from when; the zero address if none.
    pub fn waiting(self, now: Instant) -> (Address, Instant) {
        if self.next != Address::zero() && !cooled(at: self.from, now) {
            (self.next, self.from)
        } else {
            (Address::zero(), NOT_SET)
        }
    }

    /// The owner replaces the agent's key. The key in use stops at once (a
    /// tightening); the new one waits out the cooling period (a loosening),
    /// and naming the zero address leaves the vault with no agent. False,
    /// and nothing changed, when `who` is the owner: the vault refuses that.
    #[must_use]
    pub fn replace(
        mut self,
        _ proof: own OwnerCall,
        terms: Terms,
        owner: Owner,
        who: Address,
    ) -> bool {
        let now = proof.now
        let _ = kernel_proof(proof)
        if who == owner.address {
            return false
        }
        if terms.blank() {
            return true
        }
        self.agent = Address::zero()
        self.next = who
        self.from = if who == Address::zero() {
            NOT_SET
        } else {
            matures_at(terms.rules.schedule, now)
        }
        true
    }
}

impl Books {
    pub fn ledger(self) -> Ledger {
        self.ledger
    }

    /// The token the vault pays in.
    pub fn token(self) -> Address {
        self.token
    }

    /// The agent's payment of `amount` to `to`, judged by the kernel at the
    /// chain's time with the caller read from `ctx`. If it is allowed, the
    /// spending is counted here first and the payout to make is returned.
    pub fn judge(
        mut self,
        _ at: Moment,
        terms: TermsNow,
        seat: AgentNow,
        approval: Approval,
        to: Address,
        amount: u256,
        nonce: u64,
    ) -> Verdict {
        let now = at.now
        let agent = seat.agent
        let request = Request {
            amount,
            nonce,
            from_agent: agent != Address::zero() && at.caller == agent,
            to_approved: cooled(at: approval.of(to), now),
        }
        match decide(rules: terms.rules, ledger: self.ledger, request, now) {
            Decision::Allow(next) => {
                self.ledger = next
                Verdict::Pay(Payout { token: self.token, to, amount })
            },
            Decision::Deny(reason) => Verdict::Refuse(reason),
        }
    }
}

impl Payout {
    pub fn to(self) -> Address {
        self.to
    }

    pub fn amount(self) -> u256 {
        self.amount
    }

    /// Makes the payment the kernel allowed, and nothing else.
    pub fn send(own self) uses (ctx: Ctx, call: mut Call) {
        safe_transfer(token: self.token, receiver: self.to, amount: self.amount)
    }
}

/// Sends `amount` of `token` to the owner, and to no one else.
pub fn withdraw(_ proof: own OwnerCall, owner: Owner, token: Address, amount: u256)
uses (ctx: Ctx, call: mut Call)
{
    let _ = kernel_proof(proof)
    safe_transfer(token, receiver: owner.address, amount)
}
