//! What a vault on the EVM holds, sealed so that only the kernel can make it.
//!
//! The pure kernel works on plain values: anyone can build a `Rules`, and
//! `authorize` hands an `OwnerProof` to whoever passes it the same value
//! twice. That is what the tests, the adversary and the native tool need. A
//! vault must not have that freedom, so it does not store a `Rules` and its
//! kernel calls do not take an `OwnerProof`. It stores the types below, whose
//! fields are private to this module tree, so no other module can build one,
//! read a field or write one (the compiler refuses all three as "not
//! visible").
//!
//! - `Terms` wraps the rules. New `Terms` come only from `open` and from
//!   `Terms::amend`, `cancel` and `pause`, which run the kernel's own
//!   `amend` and `cancel`: a loosening waits out the cooling period.
//! - `Owner` is the address allowed to change them. It comes only from
//!   `open`.
//! - `OwnerCall` is what `amend`, `cancel`, `pause` and `approve_from` ask
//!   for. It comes only from `prove`, which compares an `Owner` with the
//!   caller read from an `Evm`. `Evm` is a concrete type whose methods read
//!   the EVM itself, so a stand-in that implements `Ctx` cannot be passed.
//! - `Approval` is when a recipient may be paid. New ones come only from
//!   `founding`, for the recipients a vault is created with, and from
//!   `Terms::approve_from`, which runs the kernel's `approve_from`: a new
//!   recipient waits out the cooling period.
//!
//! Three checks here run when the code runs, not when it compiles: `open`
//! and `founding` refuse unless the contract is still being deployed (its
//! code size is zero); a `Terms` or `Owner` read from storage nobody wrote
//! (all zeros) does nothing: `prove` refuses the zero owner, and `amend`,
//! `cancel` and `pause` leave zeroed terms as they are; and an `Approval`
//! names the address it was made for, so one copied under another address
//! approves no one.
#![cfg(target = "evm")]

use std::evm::{Address, Evm}
use super::{
    amend,
    approve_from,
    cancel,
    Instant,
    NOT_SET,
    OwnerProof,
    Policy,
    Queued,
    Rules,
    Schedule,
    Seconds,
}

/// The address allowed to change a vault's rules.
pub struct Owner { address: Address }

/// A vault's rules, as only the kernel can change them.
pub struct Terms { rules: Rules }

/// Evidence that the current call comes from the `Owner` it was proved
/// against, and the chain's time when it was proved. Like `OwnerProof`: not
/// `Copy`, spent by its first use, and a proof that is made and dropped is
/// refused. The time is read from the concrete `Evm` by `prove` and its
/// field is private, so the functions below cannot be given any other time.
#[must_use]
pub struct OwnerCall { granted: bool, now: Instant }

/// The moment from which `who` may be paid. Second zero, which is also
/// what storage nobody wrote holds, means not approved.
pub struct Approval { who: Address, from: Instant }

impl Copy for Owner {}
impl Copy for Approval {}

impl Approval {
    /// The moment from which `who` may be paid: second zero (not approved)
    /// unless this approval was made for `who`.
    pub fn of(self, _ who: Address) -> Instant {
        if self.who == who { self.from } else { NOT_SET }
    }
}

impl Owner {
    pub fn address(self) -> Address {
        self.address
    }
}

/// The owner and the first rules of a contract that is being deployed:
/// `policy` in force from the start, nothing queued. `None` once the
/// contract has code (that is, after its constructor), or when `owner` is
/// the zero address or the window is zero long.
pub fn open(_ ctx: Evm, owner: Address, schedule: Schedule, policy: Policy) -> Option<
    (Owner, Terms),
> {
    if ctx.extcodesize(ctx.address()) != 0
        || owner == Address::zero()
        || schedule.window_secs == Seconds::of(0) {
        return Option::None
    }
    let rules = Rules { schedule, active: policy, queued: Queued::none() }
    Option::Some((Owner { address: owner }, Terms { rules }))
}

/// `who` approved from now, for a recipient the vault is created with.
/// `None` once the contract has code, as for `open`.
pub fn founding(_ ctx: Evm, who: Address) -> Option<Approval> {
    if ctx.extcodesize(ctx.address()) != 0 {
        return Option::None
    }
    let now = Instant::at(ctx.timestamp().as_seconds().downcast_saturate())
    Option::Some(Approval { who, from: now })
}

/// An `OwnerCall` when the caller of the current call is `owner`,
/// carrying the chain's time.
pub fn prove(_ owner: Owner, ctx: Evm) -> Option<OwnerCall> {
    if owner.address != Address::zero() && ctx.caller() == owner.address {
        let now = Instant::at(ctx.timestamp().as_seconds().downcast_saturate())
        Option::Some(OwnerCall { granted: true, now })
    } else {
        Option::None
    }
}

/// The kernel's proof, for the kernel's own functions. Only made from an
/// `OwnerCall`, which this spends.
fn kernel_proof(_ call: own OwnerCall) -> OwnerProof {
    OwnerProof { granted: call.granted }
}

impl Terms {
    pub fn rules(self) -> Rules {
        self.rules
    }

    /// Zeroed storage, not something `open` made.
    fn blank(self) -> bool {
        self.rules.schedule.window_secs == Seconds::of(0)
    }

    /// The kernel's `amend`, at the time the proof carries.
    pub fn amend(mut self, _ proof: own OwnerCall, proposed: Policy) {
        let now = proof.now
        let proof = kernel_proof(proof)
        if !self.blank() {
            self.rules = amend(proof, rules: self.rules, proposed, now)
        }
    }

    /// The kernel's `cancel`, at the time the proof carries.
    pub fn cancel(mut self, _ proof: own OwnerCall) {
        let now = proof.now
        let proof = kernel_proof(proof)
        if !self.blank() {
            self.rules = cancel(proof, rules: self.rules, now)
        }
    }

    /// The policy in force, paused, applied at once; anything queued is
    /// dropped.
    pub fn pause(mut self, _ proof: own OwnerCall) {
        var stopped = self.rules.current(now: proof.now)
        stopped.paused = true
        self.amend(proof, proposed: stopped)
    }

    /// The kernel's `approve_from` for `who`, with this vault's schedule,
    /// at the time the proof carries. `current` is what is stored for `who` now.
    pub fn approve_from(
        self,
        _ proof: own OwnerCall,
        who: Address,
        current: Approval,
        approved: bool,
    ) -> Approval {
        let now = proof.now
        let proof = kernel_proof(proof)
        if self.blank() {
            return current
        }
        let from = approve_from(
            proof,
            self.rules.schedule,
            current: current.of(who),
            approved,
            now,
        )
        Approval { who, from }
    }
}
