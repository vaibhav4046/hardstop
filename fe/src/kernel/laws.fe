static_assert(a_waiting_raise_is_counted(from: 60, count: 4))
static_assert(a_waiting_raise_is_counted(from: 64, count: 4))
static_assert(a_waiting_raise_is_counted(from: 68, count: 4))

// Law 8, for every policy of the smaller grid, in each of five setups.
static_assert(exact_at_the_edges(from: 0, count: 12))
static_assert(exact_at_the_edges(from: 12, count: 12))
static_assert(exact_at_the_edges(from: 24, count: 12))
static_assert(exact_at_the_edges(from: 36, count: 12))
static_assert(exact_at_the_edges(from: 48, count: 12))
static_assert(exact_at_the_edges(from: 60, count: 12))

// Laws 6 and 7 are not about nothing. $250 a window over the 7 windows the
// span touches, reached in full payments of $100, or of $30 and the rest;
// 3 windows when the policy ends at second 1800; and a raise signed at
// `NOW` that the greedy agent does spend once it takes effect.
static_assert(greedy(bounded(35)) == 1750 && greedy(bounded(34)) == 1750)
static_assert(greedy(bounded(17)) == 750)
static_assert(take(signed(calm(bounded(31)), bounded(35)), until: LATE) > greedy(bounded(31)))
