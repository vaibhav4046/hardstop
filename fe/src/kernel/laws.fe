static_assert(a_payment_fits_the_worst_case(from: 64, count: 32))
static_assert(a_payment_fits_the_worst_case(from: 96, count: 32))

// Law 6, for every policy of the smaller grid.
static_assert(the_worst_case_is_exact(from: 0, count: 12))
static_assert(the_worst_case_is_exact(from: 12, count: 12))
static_assert(the_worst_case_is_exact(from: 24, count: 12))
static_assert(the_worst_case_is_exact(from: 36, count: 12))
static_assert(the_worst_case_is_exact(from: 48, count: 12))
