//! The ratchet's laws, checked by the compiler over a grid of policies.
//!
//! Each `static_assert` here runs a `const fn` while the kernel compiles:
//! the compiler itself runs `amend`, `cancel`, `meet`, `loosens`, `decide`
//! and `exposure` on every policy in the grid below, and a law that fails
//! for any of them stops the build with "static assertion failed" (8-0081).
//!
//! Each check covers half of what Fe's per-check step limit allows (error
//! 3-0026), so that a harmless change to the kernel does not push it over.
//!
//! The grid is 128 policies: each cap one of 0, 1, 100 or the largest
//! number there is, an end date before, inside or after the cooling period,
//! paused or not. It is a grid, not every input: the tests and the seeded
//! adversary cover breadth. The laws are about the kernel, the code the
//! vault runs on every call; they say nothing about the vault's own glue.
//!
//! Nothing here is `pub`: the module makes owner proofs by hand to run
//! `amend` and `cancel`, and a CI source check keeps that door closed.

use super::{
    amend,
    cancel,
    decide,
    exposure,
    loosens,
    meet,
    Decision,
    Instant,
    Ledger,
    OwnerProof,
    Policy,
    Queued,
    Reason,
    Request,
    Rules,
    Schedule,
    Seconds,
}

const MOST: u256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935
const GRID: u64 = 128
/// The owner signs at this second...
const NOW: Instant = Instant { secs: 1000 }
/// ...in a vault whose loosenings wait this long...
const COOLING: u64 = 3600
/// ...and whose windows are this long.
const WINDOW: u64 = 600
/// The last second before anything signed at `NOW` could loosen the rules.
const LAST_SAFE: Instant = Instant { secs: 4599 }
/// The first second it could.
const FIRST_LOOSE: Instant = Instant { secs: 4600 }

/// 0, 1, 100 or the largest amount.
const fn amount(_ i: u64) -> u256 {
    if i == 0 {
        0
    } else if i == 1 {
        1
    } else if i == 2 { 100 } else { MOST }
}

/// Policy number `n` of the grid.
const fn policy(_ n: u64) -> Policy {
    Policy {
        per_payment: amount(n % 4),
        per_window: amount((n / 4) % 4),
        // Second 0, 1800 (inside the cooling period, and a moment the greedy agent pays at), 4600 (the moment it
        // ends) or 6000 (after it).
        valid_until: Instant::at(
            if (n / 16) % 4 == 0 {
                0
            } else if (n / 16) % 4 == 1 {
                1800
            } else if (n / 16) % 4 == 2 { 4600 } else { 6000 },
        ),
        paused: (n / 64) % 2 == 1,
    }
}

/// `active` in force since second 0, nothing queued.
const fn calm(_ active: Policy) -> Rules {
    Rules {
        schedule: Schedule {
            anchor: Instant::at(0),
            window_secs: Seconds::of(WINDOW),
            cooling_secs: Seconds::of(COOLING),
        },
        active,
        queued: Queued::none(),
    }
}

/// Spending in the window `NOW` falls in: nothing, 100, or everything.
const fn ledger(_ i: u64) -> Ledger {
    Ledger { window: 1, spent: amount(i), next_nonce: 7 }
}

const fn same(_ a: Policy, _ b: Policy) -> bool {
    !loosens(a, to: b) && !loosens(b, to: a)
}

const fn signed(_ rules: Rules, _ proposed: Policy) -> Rules {
    amend(OwnerProof { granted: true }, rules, proposed, now: NOW)
}

/// Law 1. No policy loosens itself, and the tightest of two policies is
/// never looser than either.
const fn meet_never_loosens(from: u64, count: u64) -> bool {
    var a: u64 = from
    while a < from + count {
        let pa = policy(a)
        if loosens(pa, to: pa) {
            return false
        }
        var b: u64 = 0
        while b < GRID {
            let pb = policy(b)
            let m = meet(pa, pb)
            if loosens(pa, to: m) || loosens(pb, to: m) {
                return false
            }
            b += 1
        }
        a += 1
    }
    true
}

/// Law 2. Whatever the owner signs, a tighter limit applies at once, and
/// anything looser waits out the whole cooling period, to the second.
const fn signing_tightens_now_and_loosens_later(from: u64, count: u64) -> bool {
    var a: u64 = from
    while a < from + count {
        let pa = policy(a)
        let ra = calm(pa)
        var p: u64 = 0
        while p < GRID {
            let pp = policy(p)
            let rules = signed(ra, pp)
            let tight = meet(pa, pp)
            let later = if loosens(tight, to: pp) { pp } else { tight }
            if !same(rules.current(now: NOW), tight)
                || !same(rules.current(now: LAST_SAFE), tight)
                || !same(rules.current(now: FIRST_LOOSE), later) {
                return false
            }
            p += 1
        }
        a += 1
    }
    true
}

/// Law 3. A raise cancelled before it matures never happens: after the
/// cancel, no moment is looser than what was in force when it was signed.
const fn a_cancelled_raise_never_happens(from: u64, count: u64) -> bool {
    var a: u64 = from
    while a < from + count {
        let pa = policy(a)
        let ra = calm(pa)
        var p: u64 = 0
        while p < GRID {
            let rules = cancel(
                OwnerProof { granted: true },
                rules: signed(ra, policy(p)),
                now: LAST_SAFE,
            )
            if loosens(pa, to: rules.current(now: FIRST_LOOSE))
                || loosens(
                    pa,
                    to: rules.current(now: Instant::at(18446744073709551615)),
                ) {
                return false
            }
            p += 1
        }
        a += 1
    }
    true
}

/// Law 4, the promise the vault shows its owner. Whatever the owner signs,
/// the most the agent can move before the cooling period ends does not go
/// up: a tricked approval changes nothing the agent can reach in time.
const fn a_signature_cannot_raise_the_worst_case(from: u64, count: u64, spent: u64) -> bool {
    var a: u64 = from
    while a < from + count {
        let ra = calm(policy(a))
        let held = ledger(spent)
        let before = exposure(rules: ra, ledger: held, now: NOW, until: LAST_SAFE)
        var p: u64 = 0
        while p < GRID {
            if exposure(
                    rules: signed(ra, policy(p)),
                    ledger: held,
                    now: NOW,
                    until: LAST_SAFE,
                )
                > before {
                return false
            }
            p += 1
        }
        a += 1
    }
    true
}

/// Law 5. The vault never pays more than the worst case it reports, and a
/// payment uses up at least its own amount of that worst case.
const fn a_payment_fits_the_worst_case(from: u64, count: u64) -> bool {
    var a: u64 = from
    while a < from + count {
        var spent: u64 = 0
        while spent < 4 {
            let before = exposure(
                rules: calm(policy(a)),
                ledger: ledger(spent),
                now: NOW,
                until: LAST_SAFE,
            )
            var asked: u64 = 1
            while asked < 4 {
                let request = Request {
                    amount: amount(asked),
                    nonce: 7,
                    from_agent: true,
                    to_approved: true,
                }
                match decide(
                    rules: calm(policy(a)),
                    ledger: ledger(spent),
                    request,
                    now: NOW,
                ) {
                    Decision::Allow(next) => {
                        let after = exposure(
                            rules: calm(policy(a)),
                            ledger: next,
                            now: NOW,
                            until: LAST_SAFE,
                        )
                        if amount(asked) > before
                            || (before != MOST && after > before - amount(asked)) {
                            return false
                        }
                    },
                    Decision::Deny(_) => {},
                }
                asked += 1
            }
            spent += 1
        }
        a += 1
    }
    true
}

/// Policy number `n` of a smaller grid with no unbounded caps, so that an
/// agent can spend all of it one payment at a time: each cap 0, 30 or 100
/// per payment and 0, 100 or 250 per window; the same end dates and pause.
const fn bounded(_ n: u64) -> Policy {
    let base = policy((n / 9) * 16)
    Policy {
        per_payment: if n % 3 == 0 {
            0
        } else if n % 3 == 1 { 30 } else { 100 },
        per_window: if (n / 3) % 3 == 0 {
            0
        } else if (n / 3) % 3 == 1 { 100 } else { 250 },
        valid_until: base.valid_until,
        paused: (n / 36) % 2 == 1,
    }
}

/// What a greedy agent gets paid at `at`: it asks for a full payment under
/// the policy in force, and when refused for the window cap it asks for
/// what is left. Returns the total and the ledger after.
const fn drain(_ rules: Rules, _ held: Ledger, at: Instant) -> (u256, Ledger) {
    var ledger_now = held
    var total: u256 = 0
    var ask = rules.current(now: at).per_payment
    var tries: u64 = 0
    while tries < 12 {
        let request = Request {
            amount: ask,
            nonce: ledger_now.next_nonce,
            from_agent: true,
            to_approved: true,
        }
        match decide(rules, ledger: ledger_now, request, now: at) {
            Decision::Allow(next) => {
                total += ask
                ledger_now = next
            },
            Decision::Deny(reason) => {
                match reason {
                    Reason::OverWindowLimit(left) => {
                        if left == 0 { tries = 12 } else { ask = left }
                    },
                    _ => {
                        tries = 12
                    },
                }
            },
        }
        tries += 1
    }
    (total, ledger_now)
}

/// What a greedy agent gets paid from `NOW` to `until`: it drains the vault
/// at `NOW`, at the start of every later window, and at `FIRST_LOOSE`, the
/// moment anything signed at `NOW` could take effect.
const fn take(_ rules: Rules, until: Instant) -> u256 {
    var held = ledger(0)
    var total: u256 = 0
    var window: u64 = 1
    while window * WINDOW <= until.secs() {
        let at = if window * WINDOW < NOW.secs() {
            NOW
        } else {
            Instant::at(window * WINDOW)
        }
        let (paid, after) = drain(rules, held, at)
        total += paid
        held = after
        if at < FIRST_LOOSE && FIRST_LOOSE.secs() < (window + 1) * WINDOW && FIRST_LOOSE <= until {
            let (more, later) = drain(rules, held, at: FIRST_LOOSE)
            total += more
            held = later
        }
        window += 1
    }
    total
}

/// What a greedy agent gets paid from `NOW` to `LAST_SAFE` under `active`.
const fn greedy(_ active: Policy) -> u256 {
    take(calm(active), until: LAST_SAFE)
}

/// Law 6. The worst case is exact: a greedy agent gets paid exactly what
/// `exposure` reports, so it is neither more than the vault lets through
/// nor a padded guess.
const fn the_worst_case_is_exact(from: u64, count: u64) -> bool {
    var n: u64 = from
    while n < from + count {
        let active = bounded(n)
        if greedy(active)
            != exposure(
                rules: calm(active),
                ledger: ledger(0),
                now: NOW,
                until: LAST_SAFE,
            ) {
            return false
        }
        n += 1
    }
    true
}

/// The end of a longer span: past `FIRST_LOOSE`, so a raise signed at `NOW`
/// takes effect inside it.
const LATE: Instant = Instant { secs: 5999 }

/// Law 7. A waiting raise is counted: when the owner signs a raise at
/// `NOW`, a greedy agent over a span in which it takes effect gets paid no
/// more than `exposure` reported at `NOW`. Each `bounded` policy, against
/// each of the nine that end at second 6000 and are not paused.
const fn a_waiting_raise_is_counted(from: u64, count: u64) -> bool {
    var a: u64 = from
    while a < from + count {
        let ra = calm(bounded(a))
        var p: u64 = 27
        while p < 36 {
            let rules = signed(ra, bounded(p))
            if take(rules, until: LATE)
                > exposure(rules, ledger: ledger(0), now: NOW, until: LATE) {
                return false
            }
            p += 1
        }
        a += 1
    }
    true
}

// touches, reached in full payments of $100 or $30 and the rest; and 3
// windows when the policy ends at second 1800.

/// A vault set up another way: windows of `window` seconds, loosenings
/// waiting `cooling` seconds, `active` in force since second 0.
const fn setup(_ active: Policy, window: u64, cooling: u64) -> Rules {
    Rules {
        schedule: Schedule {
            anchor: Instant::at(0),
            window_secs: Seconds::of(window),
            cooling_secs: Seconds::of(cooling),
        },
        active,
        queued: Queued::none(),
    }
}

/// What a greedy agent gets paid from `from` to `until`, both inclusive:
/// it drains the vault at `from` and at the start of every later window.
const fn take_span(_ rules: Rules, from: Instant, until: Instant) -> u256 {
    if until < from { return 0 }
    let window = rules.schedule.window_secs.secs()
    let (first, after_first) = drain(
        rules,
        Ledger { window: 0, spent: 0, next_nonce: 7 },
        at: from,
    )
    var total: u256 = first
    var held = after_first
    var w: u64 = from.secs() / window + 1
    while w * window <= until.secs() {
        let (more, later) = drain(rules, held, at: Instant::at(w * window))
        total += more
        held = later
        w += 1
    }
    total
}

/// The five setups of law 8: (window, cooling, from, until).
const fn edge(_ k: u64) -> (u64, u64, u64, u64) {
    if k == 0 {
        // A span of no time at all.
        (600, 3600, 1000, 1000)
    } else if k == 1 {
        // One second.
        (600, 3600, 1000, 1001)
    } else if k == 2 {
        // The last second of a window and the first of the next.
        (600, 3600, 1199, 1200)
    } else if k == 3 {
        // Hour windows, a one-minute cooling period, across a window's edge.
        (3600, 60, 3599, 3600)
    } else {
        // Day windows over two days.
        (86400, 86400, 50, 172800)
    }
}

/// Law 8. The worst case stays exact at the edges and under other
/// schedules: for spans of no time and of one second, across a window's
/// edge, with hour windows and a one-minute cooling period, and with day
/// windows over two days, a greedy agent gets paid exactly what
/// `exposure` reports. Each policy of the smaller grid, in each setup.
const fn exact_at_the_edges(from: u64, count: u64) -> bool {
    var n: u64 = from
    while n < from + count {
        let active = bounded(n)
        var k: u64 = 0
        while k < 5 {
            let (window, cooling, start, end) = edge(k)
            let rules = setup(active, window, cooling)
            let ledger = Ledger { window: 0, spent: 0, next_nonce: 7 }
            let start_at = Instant::at(start)
            let end_at = Instant::at(end)
            if take_span(rules, from: start_at, until: end_at)
                != exposure(rules, ledger, now: start_at, until: end_at) {
                return false
            }
            k += 1
        }
        n += 1
    }
    true
}

