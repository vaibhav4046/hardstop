//! Vault tests on the EVM. The test contract plays the owner; `Actor`
//! contracts play the agent and a stranger, because the caller is whoever
//! sends the message.
//!
//! `fe test` cannot move the clock, so anything that needs time to pass
//! (a queued raise maturing, a new window) is tested on the kernel in
//! `tests.fe` and against the compiled contract in `web/tests/`.
#![cfg(target = "evm")]

use std::evm::{Address, Call, Evm}
use ingot::token::{TestDollar, TokenMsg}
use ingot::vault::{Vault, VaultMsg}

const USD: u256 = 1000000
const GAS: u256 = 3000000
const DAY: u64 = 86400
const FAR_FUTURE: u64 = 4000000000

msg ActorMsg {
    #[selector = sol("pay(address,address,uint256,uint64)")]
    Pay { vault: Address, to: Address, amount: u256, nonce: u64 } -> u8,
    #[selector = sol("raiseLimits(address,uint256,uint256)")]
    RaiseLimits { vault: Address, per_payment: u256, per_window: u256 },
    #[selector = sol("drain(address,uint256)")]
    Drain { vault: Address, amount: u256 },
    #[selector = sol("approve(address,address)")]
    Approve { vault: Address, who: Address },
    #[selector = sol("cancel(address)")]
    Cancel { vault: Address },
    #[selector = sol("pause(address)")]
    Pause { vault: Address },
}

/// Forwards whatever it is told to the vault, so the vault sees this
/// contract as the caller.
contract Actor uses (call: mut Call) {
    recv ActorMsg {
        Pay { vault, to, amount, nonce } -> u8 uses (mut call) {
            call.call(
                addr: vault,
                gas: 1500000,
                value: Wei::zero(),
                message: VaultMsg::Pay { to, amount, nonce },
            )
        }
        RaiseLimits { vault, per_payment, per_window }
        uses (mut call)
        {
            call.call(
                addr: vault,
                gas: 1500000,
                value: Wei::zero(),
                message: VaultMsg::Propose {
                    per_payment,
                    per_window,
                    valid_until: FAR_FUTURE,
                    paused: false,
                },
            )
        }
        Drain { vault, amount } uses (mut call) {
            call.call(
                addr: vault,
                gas: 1500000,
                value: Wei::zero(),
                message: VaultMsg::Withdraw { amount },
            )
        }
        Approve { vault, who } uses (mut call) {
            call.call(
                addr: vault,
                gas: 1500000,
                value: Wei::zero(),
                message: VaultMsg::SetRecipient { who, approved: true },
            )
        }
        Cancel { vault } uses (mut call) {
            call.call(
                addr: vault,
                gas: 1500000,
                value: Wei::zero(),
                message: VaultMsg::CancelQueued {},
            )
        }
        Pause { vault } uses (mut call) {
            call.call(
                addr: vault,
                gas: 1500000,
                value: Wei::zero(),
                message: VaultMsg::Pause {},
            )
        }
    }
}

/// A token whose `transfer` always reports failure.
msg BrokenMsg {
    #[selector = sol("transfer(address,uint256)")]
    Transfer { to: Address, amount: u256 } -> bool,
}

contract BrokenToken {
    recv BrokenMsg {
        Transfer { to, amount } -> bool {
            false
        }
    }
}

/// A hostile contract that is both the token and the agent. Its `transfer`
/// re-enters `pay` three times and records what the vault answered.
msg EvilMsg {
    #[selector = sol("transfer(address,uint256)")]
    Transfer { to: Address, amount: u256 } -> bool,
    #[selector = sol("go(address,address,uint256)")]
    Go { vault: Address, to: Address, amount: u256 } -> u8,
    #[selector = sol("codes()")]
    Codes -> (u8, u8, u8, u256),
}

contract Evil uses (call: mut Call) {
    mut target: Address,
    mut depth: u256,
    mut replay: u8,
    mut second: u8,
    mut third: u8,

    recv EvilMsg {
        Go { vault, to, amount } -> u8 uses (mut call, mut target) {
            target = vault
            call.call(
                addr: vault,
                gas: 2000000,
                value: Wei::zero(),
                message: VaultMsg::Pay { to, amount, nonce: 0 },
            )
        }

        Transfer { to, amount } -> bool uses (
            mut call,
            target,
            mut depth,
            mut replay,
            mut second,
            mut third,
        ) {
            depth = depth + 1
            if depth == 1 {
                replay = call
                    .call(
                        addr: target,
                        gas: 500000,
                        value: Wei::zero(),
                        message: VaultMsg::Pay { to, amount, nonce: 0 },
                    )
                second = call
                    .call(
                        addr: target,
                        gas: 500000,
                        value: Wei::zero(),
                        message: VaultMsg::Pay { to, amount, nonce: 1 },
                    )
                third = call
                    .call(
                        addr: target,
                        gas: 500000,
                        value: Wei::zero(),
                        message: VaultMsg::Pay { to, amount: 1, nonce: 2 },
                    )
            }
            true
        }

        Codes -> (u8, u8, u8, u256) uses (replay, second, third, depth) {
            (replay, second, third, depth)
        }
    }
}

struct World {
    token: Address,
    vault: Address,
    agent: Address,
    stranger: Address,
    shop: Address,
    thief: Address,
}

impl Copy for World {}

/// A funded vault: $100 inside, $10 per payment, $20 per day, a one-day
/// cooling period, one approved recipient (`shop`).
fn world() -> World uses (evm: mut Evm) {
    let token = evm.create2<TestDollar>(value: Wei::zero(), args: (), salt: 1)
    let w = world_with(token)
    evm.call(
        addr: token,
        gas: GAS,
        value: Wei::zero(),
        message: TokenMsg::Mint { to: w.vault, amount: 100 * USD },
    )
    w
}

fn world_with(_ token: Address) -> World uses (evm: mut Evm) {
    let agent = evm.create2<Actor>(value: Wei::zero(), args: (), salt: 2)
    let stranger = evm.create2<Actor>(value: Wei::zero(), args: (), salt: 3)
    let shop = Address::new(0x5109)
    let thief = Address::new(0xbad)
    let vault = evm
        .create2<Vault>(
            value: Wei::zero(),
            args: (
                evm.address(),
                agent,
                token,
                10 * USD,
                20 * USD,
                FAR_FUTURE,
                DAY,
                DAY,
                shop,
                Address::zero(),
                Address::zero(),
            ),
            salt: 4,
        )
    World { token, vault, agent, stranger, shop, thief }
}

fn balance(_ w: World, of: Address) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: w.token,
        gas: GAS,
        value: Wei::zero(),
        message: TokenMsg::BalanceOf { who: of },
    )
}

fn agent_pays(_ w: World, to: Address, amount: u256, nonce: u64) -> u8
uses (evm: mut Evm)
{
    evm.call(
        addr: w.agent,
        gas: GAS,
        value: Wei::zero(),
        message: ActorMsg::Pay { vault: w.vault, to, amount, nonce },
    )
}

fn preview(_ w: World, to: Address, amount: u256, nonce: u64) -> (u8, u256)
uses (evm: mut Evm)
{
    evm.call(
        addr: w.vault,
        gas: GAS,
        value: Wei::zero(),
        message: VaultMsg::Preview { caller: w.agent, to, amount, nonce },
    )
}

fn now() -> u64 uses (evm: mut Evm) {
    evm.timestamp().as_seconds().downcast_saturate()
}

// --- payments -------------------------------------------------------------

#[test]
fn allowed_payment_moves_exactly_the_amount() uses (evm: mut Evm) {
    let w = world()
    assert!(agent_pays(w, to: w.shop, amount: 4 * USD, nonce: 0) == 0)
    assert!(balance(w, of: w.shop) == 4 * USD)
    assert!(balance(w, of: w.vault) == 96 * USD)
    let (window, spent, next_nonce): (u64, u256, u64) = evm
        .call(
            addr: w.vault,
            gas: GAS,
            value: Wei::zero(),
            message: VaultMsg::LedgerOf {},
        )
    assert!(window == 0)
    assert!(spent == 4 * USD)
    assert!(next_nonce == 1)
}

#[test]
fn over_limit_payment_moves_nothing() uses (evm: mut Evm) {
    let w = world()
    assert!(
        agent_pays(w, to: w.shop, amount: 80 * USD, nonce: 0) == 10,
    )
    assert!(balance(w, of: w.shop) == 0)
    assert!(balance(w, of: w.vault) == 100 * USD)
    // A refusal leaves the ledger alone: the same sequence number still works.
    assert!(agent_pays(w, to: w.shop, amount: 4 * USD, nonce: 0) == 0)
}

#[test]
fn unapproved_recipient_moves_nothing() uses (evm: mut Evm) {
    let w = world()
    assert!(agent_pays(w, to: w.thief, amount: 4 * USD, nonce: 0) == 9)
    assert!(balance(w, of: w.thief) == 0)
    assert!(balance(w, of: w.vault) == 100 * USD)
}

#[test]
fn splitting_cannot_beat_the_daily_cap() uses (evm: mut Evm) {
    let w = world()
    assert!(agent_pays(w, to: w.shop, amount: 10 * USD, nonce: 0) == 0)
    assert!(agent_pays(w, to: w.shop, amount: 10 * USD, nonce: 1) == 0)
    // $20 of $20 used. Even one more unit is refused.
    assert!(agent_pays(w, to: w.shop, amount: 1, nonce: 2) == 11)
    assert!(balance(w, of: w.shop) == 20 * USD)
}

#[test]
fn replayed_request_is_refused() uses (evm: mut Evm) {
    let w = world()
    assert!(agent_pays(w, to: w.shop, amount: 4 * USD, nonce: 0) == 0)
    assert!(agent_pays(w, to: w.shop, amount: 4 * USD, nonce: 0) == 6)
    assert!(balance(w, of: w.shop) == 4 * USD)
}

#[test]
fn preview_agrees_with_pay_and_changes_nothing() uses (evm: mut Evm) {
    let w = world()
    let (code, left) = preview(w, to: w.shop, amount: 4 * USD, nonce: 0)
    assert!(code == 0 && left == 16 * USD)
    let (code, cap) = preview(w, to: w.shop, amount: 80 * USD, nonce: 0)
    assert!(code == 10 && cap == 10 * USD)
    let (code, _) = preview(w, to: w.thief, amount: 4 * USD, nonce: 0)
    assert!(code == 9)
    assert!(agent_pays(w, to: w.shop, amount: 4 * USD, nonce: 0) == 0)
    let (code, expected) = preview(w, to: w.shop, amount: 4 * USD, nonce: 0)
    assert!(code == 6 && expected == 1)
}

#[test]
fn failed_transfer_reverts_and_leaves_the_ledger_untouched()
uses (evm: mut Evm)
{
    let broken = evm.create2<BrokenToken>(value: Wei::zero(), args: (), salt: 9)
    let w = world_with(broken)
    // The kernel allows it, the token refuses: nothing may be recorded.
    let outcome = evm
        .try_call(
            addr: w.agent,
            gas: GAS,
            value: Wei::zero(),
            message: ActorMsg::Pay { vault: w.vault, to: w.shop, amount: 4 * USD, nonce: 0 },
        )
    assert!(!outcome.success())
    let (window, spent, next_nonce): (u64, u256, u64) = evm
        .call(
            addr: w.vault,
            gas: GAS,
            value: Wei::zero(),
            message: VaultMsg::LedgerOf {},
        )
    assert!(window == 0 && spent == 0 && next_nonce == 0)
}

#[test]
fn a_hostile_token_cannot_reenter_past_the_caps() uses (evm: mut Evm) {
    // `Evil` is both the token and the agent. While the vault is paying it,
    // it calls `pay` again three ways.
    let evil = evm.create2<Evil>(value: Wei::zero(), args: (), salt: 21)
    let shop = Address::new(0x5109)
    let vault = evm
        .create2<Vault>(
            value: Wei::zero(),
            args: (
                evm.address(),
                evil,
                evil,
                10 * USD,
                20 * USD,
                FAR_FUTURE,
                DAY,
                DAY,
                shop,
                Address::zero(),
                Address::zero(),
            ),
            salt: 22,
        )
    let outer: u8 = evm
        .call(
            addr: evil,
            gas: GAS,
            value: Wei::zero(),
            message: EvilMsg::Go { vault, to: shop, amount: 10 * USD },
        )
    assert!(outer == 0)
    let (replay, second, third, depth): (u8, u8, u8, u256) = evm
        .call(
            addr: evil,
            gas: GAS,
            value: Wei::zero(),
            message: EvilMsg::Codes {},
        )
    assert!(depth == 2)
    // Replaying the payment in flight: refused, it is already counted.
    assert!(replay == 6)
    // A second, correctly numbered payment inside the cap: allowed, and counted.
    assert!(second == 0)
    // One unit past the window cap: refused.
    assert!(third == 11)
    let (_, spent, next_nonce): (u64, u256, u64) = evm
        .call(
            addr: vault,
            gas: GAS,
            value: Wei::zero(),
            message: VaultMsg::LedgerOf {},
        )
    assert!(spent == 20 * USD && next_nonce == 2)
}

// --- the owner's controls -------------------------------------------------

#[test]
fn pause_is_instant() uses (evm: mut Evm) {
    let w = world()
    evm.call(
        addr: w.vault,
        gas: GAS,
        value: Wei::zero(),
        message: VaultMsg::Pause {},
    )
    assert!(agent_pays(w, to: w.shop, amount: 4 * USD, nonce: 0) == 2)
    assert!(balance(w, of: w.shop) == 0)
    let bound: u256 = evm
        .call(
            addr: w.vault,
            gas: GAS,
            value: Wei::zero(),
            message: VaultMsg::Exposure { until: FAR_FUTURE },
        )
    assert!(bound == 0)
}

#[test]
fn lowering_a_limit_is_instant() uses (evm: mut Evm) {
    let w = world()
    evm.call(
        addr: w.vault,
        gas: GAS,
        value: Wei::zero(),
        message: VaultMsg::Propose {
            per_payment: 3 * USD,
            per_window: 20 * USD,
            valid_until: FAR_FUTURE,
            paused: false,
        },
    )
    assert!(agent_pays(w, to: w.shop, amount: 4 * USD, nonce: 0) == 10)
    assert!(agent_pays(w, to: w.shop, amount: 3 * USD, nonce: 0) == 0)
}

#[test]
fn raising_a_limit_is_queued_not_applied() uses (evm: mut Evm) {
    let w = world()
    evm.call(
        addr: w.vault,
        gas: GAS,
        value: Wei::zero(),
        message: VaultMsg::Propose {
            per_payment: 1000 * USD,
            per_window: 1000 * USD,
            valid_until: FAR_FUTURE,
            paused: false,
        },
    )
    // Still the old cap.
    assert!(
        agent_pays(w, to: w.shop, amount: 80 * USD, nonce: 0) == 10,
    )
    let (per_payment, per_window, _, _): (u256, u256, u64, bool) = evm
        .call(
            addr: w.vault,
            gas: GAS,
            value: Wei::zero(),
            message: VaultMsg::PolicyOf {},
        )
    assert!(per_payment == 10 * USD && per_window == 20 * USD)
    let (queued_payment, _, _, _, effective_at): (u256, u256, u64, bool, u64) = evm
        .call(
            addr: w.vault,
            gas: GAS,
            value: Wei::zero(),
            message: VaultMsg::QueuedOf {},
        )
    assert!(queued_payment == 1000 * USD)
    assert!(effective_at == now() + DAY)

    // The owner changes its mind: the raise never happens.
    evm.call(
        addr: w.vault,
        gas: GAS,
        value: Wei::zero(),
        message: VaultMsg::CancelQueued {},
    )
    let (_, _, _, _, effective_at): (u256, u256, u64, bool, u64) = evm
        .call(
            addr: w.vault,
            gas: GAS,
            value: Wei::zero(),
            message: VaultMsg::QueuedOf {},
        )
    assert!(effective_at == 0)
}

#[test]
fn a_new_recipient_must_wait_out_the_cooling_period() uses (evm: mut Evm) {
    let w = world()
    evm.call(
        addr: w.vault,
        gas: GAS,
        value: Wei::zero(),
        message: VaultMsg::SetRecipient { who: w.thief, approved: true },
    )
    let from: u64 = evm
        .call(
            addr: w.vault,
            gas: GAS,
            value: Wei::zero(),
            message: VaultMsg::ApprovedFrom { who: w.thief },
        )
    assert!(from == now() + DAY)
    assert!(agent_pays(w, to: w.thief, amount: 4 * USD, nonce: 0) == 9)
    // Removing a recipient is instant.
    evm.call(
        addr: w.vault,
        gas: GAS,
        value: Wei::zero(),
        message: VaultMsg::SetRecipient { who: w.shop, approved: false },
    )
    assert!(agent_pays(w, to: w.shop, amount: 4 * USD, nonce: 0) == 9)
}

#[test]
fn exposure_view_matches_the_policy() uses (evm: mut Evm) {
    let w = world()
    let today: u256 = evm
        .call(
            addr: w.vault,
            gas: GAS,
            value: Wei::zero(),
            message: VaultMsg::Exposure { until: now() + DAY - 1 },
        )
    assert!(today == 20 * USD)
    assert!(agent_pays(w, to: w.shop, amount: 4 * USD, nonce: 0) == 0)
    let today: u256 = evm
        .call(
            addr: w.vault,
            gas: GAS,
            value: Wei::zero(),
            message: VaultMsg::Exposure { until: now() + DAY - 1 },
        )
    assert!(today == 16 * USD)
}

#[test]
fn owner_withdraws_to_itself() uses (evm: mut Evm) {
    let w = world()
    evm.call(
        addr: w.vault,
        gas: GAS,
        value: Wei::zero(),
        message: VaultMsg::Withdraw { amount: 100 * USD },
    )
    assert!(balance(w, of: w.vault) == 0)
    assert!(balance(w, of: evm.address()) == 100 * USD)
}

// --- what the agent and strangers cannot do ---------------------------------
// Each test names the exact error it expects:
//   0x0d9ab13f NotAgent()   0x30cd7471 NotOwner()   0xd06b96b1 InvalidPolicy()

#[test(should_revert, selector = 0x0d9ab13f)]
fn stranger_cannot_pay() uses (evm: mut Evm) {
    let w = world()
    let _: u8 = evm
        .call(
            addr: w.stranger,
            gas: GAS,
            value: Wei::zero(),
            message: ActorMsg::Pay { vault: w.vault, to: w.shop, amount: 1, nonce: 0 },
        )
}

#[test(should_revert, selector = 0x30cd7471)]
fn agent_cannot_raise_its_own_limits() uses (evm: mut Evm) {
    let w = world()
    evm.call(
        addr: w.agent,
        gas: GAS,
        value: Wei::zero(),
        message: ActorMsg::RaiseLimits {
            vault: w.vault,
            per_payment: 1000 * USD,
            per_window: 1000 * USD,
        },
    )
}

#[test(should_revert, selector = 0x30cd7471)]
fn agent_cannot_approve_a_recipient() uses (evm: mut Evm) {
    let w = world()
    evm.call(
        addr: w.agent,
        gas: GAS,
        value: Wei::zero(),
        message: ActorMsg::Approve { vault: w.vault, who: w.thief },
    )
}

#[test(should_revert, selector = 0x30cd7471)]
fn agent_cannot_withdraw() uses (evm: mut Evm) {
    let w = world()
    evm.call(
        addr: w.agent,
        gas: GAS,
        value: Wei::zero(),
        message: ActorMsg::Drain { vault: w.vault, amount: 100 * USD },
    )
}

#[test(should_revert, selector = 0x30cd7471)]
fn agent_cannot_cancel_a_queued_change() uses (evm: mut Evm) {
    let w = world()
    evm.call(
        addr: w.agent,
        gas: GAS,
        value: Wei::zero(),
        message: ActorMsg::Cancel { vault: w.vault },
    )
}

#[test(should_revert, selector = 0x30cd7471)]
fn agent_cannot_pause() uses (evm: mut Evm) {
    let w = world()
    evm.call(
        addr: w.agent,
        gas: GAS,
        value: Wei::zero(),
        message: ActorMsg::Pause { vault: w.vault },
    )
}

#[test(should_revert, selector = 0xd06b96b1)]
fn zero_length_window_is_rejected() uses (evm: mut Evm) {
    let token = evm.create2<TestDollar>(value: Wei::zero(), args: (), salt: 1)
    let _ = evm
        .create2<Vault>(
            value: Wei::zero(),
            args: (
                evm.address(),
                Address::new(0xa),
                token,
                1,
                1,
                FAR_FUTURE,
                0,
                DAY,
                Address::zero(),
                Address::zero(),
                Address::zero(),
            ),
            salt: 4,
        )
}

#[test(should_revert, selector = 0x0d9ab13f)]
fn stranger_is_reverted_even_while_paused() uses (evm: mut Evm) {
    let w = world()
    evm.call(
        addr: w.vault,
        gas: GAS,
        value: Wei::zero(),
        message: VaultMsg::Pause {},
    )
    // Without the revert a stranger could write `Blocked` entries of its
    // choosing into the vault's log for as long as the pause lasts.
    let _: u8 = evm
        .call(
            addr: w.stranger,
            gas: GAS,
            value: Wei::zero(),
            message: ActorMsg::Pay { vault: w.vault, to: w.thief, amount: 999 * USD, nonce: 77 },
        )
}

#[test(should_revert, selector = 0xd06b96b1)]
fn owner_and_agent_must_differ() uses (evm: mut Evm) {
    let token = evm.create2<TestDollar>(value: Wei::zero(), args: (), salt: 1)
    let both = evm.create2<Actor>(value: Wei::zero(), args: (), salt: 2)
    let _ = evm
        .create2<Vault>(
            value: Wei::zero(),
            args: (
                both,
                both,
                token,
                1,
                1,
                FAR_FUTURE,
                DAY,
                DAY,
                Address::zero(),
                Address::zero(),
                Address::zero(),
            ),
            salt: 4,
        )
}

#[test(should_revert, selector = 0xd06b96b1)]
fn cooling_period_under_a_minute_is_rejected() uses (evm: mut Evm) {
    let token = evm.create2<TestDollar>(value: Wei::zero(), args: (), salt: 1)
    let _ = evm
        .create2<Vault>(
            value: Wei::zero(),
            args: (
                evm.address(),
                Address::new(0xa),
                token,
                1,
                1,
                FAR_FUTURE,
                DAY,
                59,
                Address::zero(),
                Address::zero(),
                Address::zero(),
            ),
            salt: 4,
        )
}

//   0xd92e233d ZeroAddress()

#[test(should_revert, selector = 0xd92e233d)]
fn zero_owner_is_rejected() uses (evm: mut Evm) {
    let token = evm.create2<TestDollar>(value: Wei::zero(), args: (), salt: 1)
    let _ = evm
        .create2<Vault>(
            value: Wei::zero(),
            args: (
                Address::zero(),
                Address::new(0xa),
                token,
                1,
                1,
                FAR_FUTURE,
                DAY,
                DAY,
                Address::zero(),
                Address::zero(),
                Address::zero(),
            ),
            salt: 5,
        )
}

#[test(should_revert, selector = 0xd92e233d)]
fn zero_agent_is_rejected() uses (evm: mut Evm) {
    let token = evm.create2<TestDollar>(value: Wei::zero(), args: (), salt: 1)
    let _ = evm
        .create2<Vault>(
            value: Wei::zero(),
            args: (
                evm.address(),
                Address::zero(),
                token,
                1,
                1,
                FAR_FUTURE,
                DAY,
                DAY,
                Address::zero(),
                Address::zero(),
                Address::zero(),
            ),
            salt: 6,
        )
}

#[test(should_revert, selector = 0xd92e233d)]
fn zero_token_is_rejected() uses (evm: mut Evm) {
    let _ = evm
        .create2<Vault>(
            value: Wei::zero(),
            args: (
                evm.address(),
                Address::new(0xa),
                Address::zero(),
                1,
                1,
                FAR_FUTURE,
                DAY,
                DAY,
                Address::zero(),
                Address::zero(),
                Address::zero(),
            ),
            salt: 7,
        )
}
