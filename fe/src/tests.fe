use ingot::kernel::{decide, Decision, Ledger, Policy, Reason, Request}

fn policy() -> Policy {
    Policy {
        per_payment: 10,
        per_window: 20,
        window_secs: 86400,
        anchor: 1000,
        valid_until: 1000000,
        paused: false,
    }
}

fn fresh() -> Ledger {
    Ledger { window: 0, spent: 0, next_nonce: 0 }
}

fn ask(amount: u256, nonce: u64) -> Request {
    Request { amount, nonce, from_agent: true, to_approved: true }
}

#[test]
fn allows_small_payment() {
    let d = decide(
        policy: policy(),
        ledger: fresh(),
        request: ask(amount: 4, nonce: 0),
        now: 2000,
    )
    assert!(d.code() == 0)
    assert!(d.detail(policy: policy()) == 16)
}

#[test]
fn blocks_over_payment_limit() {
    let d = decide(
        policy: policy(),
        ledger: fresh(),
        request: ask(amount: 80, nonce: 0),
        now: 2000,
    )
    assert!(d.code() == 10)
    assert!(d.detail(policy: policy()) == 10)
}
