//! Kernel tests. No `#[cfg]`: every test here runs on the EVM (`fe test`) and
//! on the native target (`fe test --backend native`).

use ingot::kernel::{
    amend,
    approve_from,
    authorize,
    cancel,
    decide,
    exposure,
    loosens,
    meet,
    Decision,
    Instant,
    Ledger,
    OwnerProof,
    Policy,
    Queued,
    Reason,
    Request,
    Rules,
    Schedule,
    Seconds,
}

const DAY: u64 = 86400
const T0: u64 = 1000000
const MAX_U64: u64 = 18446744073709551615
const MAX_U256: u256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935

fn at(_ secs: u64) -> Instant {
    Instant::at(secs)
}

fn secs(_ secs: u64) -> Seconds {
    Seconds::of(secs)
}

fn policy() -> Policy {
    Policy { per_payment: 10, per_window: 20, valid_until: at(T0 + 30 * DAY), paused: false }
}

/// The owner the tests act as, and a stranger.
const OWNER: u64 = 1
const STRANGER: u64 = 2

/// A proof for the owner, obtained the only way there is.
fn owner() -> OwnerProof {
    authorize(owner: OWNER, caller: OWNER).unwrap()
}

fn rules() -> Rules {
    Rules {
        schedule: Schedule { anchor: at(T0), window_secs: secs(DAY), cooling_secs: secs(DAY) },
        active: policy(),
        queued: Queued::none(),
    }
}

fn fresh() -> Ledger {
    Ledger { window: 0, spent: 0, next_nonce: 0 }
}

fn ask(amount: u256, nonce: u64) -> Request {
    Request { amount, nonce, from_agent: true, to_approved: true }
}

fn code(_ rules: Rules, _ ledger: Ledger, _ request: Request, now: u64) -> u8 {
    decide(rules, ledger, request, now: at(now)).code()
}

// --- decide ---------------------------------------------------------------

#[test]
fn allows_a_payment_inside_every_limit() {
    let d = decide(
        rules: rules(),
        ledger: fresh(),
        request: ask(amount: 4, nonce: 0),
        now: at(T0 + 5),
    )
    assert!(d.code() == 0)
    assert!(d.detail(policy: policy()) == 16)
    match d {
        Decision::Allow(next) => {
            assert!(next.window == 0)
            assert!(next.spent == 4)
            assert!(next.next_nonce == 1)
        },
        Decision::Deny(_) => assert!(false),
    }
}

#[test]
fn payment_cap_is_inclusive() {
    assert!(
        code(rules(), fresh(), ask(amount: 10, nonce: 0), now: T0) == 0,
    )
    let d = decide(
        rules: rules(),
        ledger: fresh(),
        request: ask(amount: 11, nonce: 0),
        now: at(T0),
    )
    assert!(d.code() == 10)
    assert!(d.detail(policy: policy()) == 10)
}

#[test]
fn window_cap_counts_what_was_already_spent() {
    let used = Ledger { window: 0, spent: 15, next_nonce: 3 }
    assert!(
        code(rules(), used, ask(amount: 5, nonce: 3), now: T0 + 9) == 0,
    )
    let d = decide(
        rules: rules(),
        ledger: used,
        request: ask(amount: 6, nonce: 3),
        now: at(T0 + 9),
    )
    assert!(d.code() == 11)
    assert!(d.detail(policy: policy()) == 5)
}

#[test]
fn a_new_window_starts_empty() {
    let used = Ledger { window: 0, spent: 20, next_nonce: 2 }
    assert!(
        code(rules(), used, ask(amount: 1, nonce: 2), now: T0 + DAY - 1) == 11,
    )
    let d = decide(
        rules: rules(),
        ledger: used,
        request: ask(amount: 10, nonce: 2),
        now: at(T0 + DAY),
    )
    match d {
        Decision::Allow(next) => {
            assert!(next.window == 1)
            assert!(next.spent == 10)
        },
        Decision::Deny(_) => assert!(false),
    }
}

#[test]
fn refusals_come_in_a_fixed_order() {
    var r = rules()
    let stranger = Request { amount: 0, nonce: 9, from_agent: false, to_approved: false }
    let agent = Request { amount: 0, nonce: 9, from_agent: true, to_approved: false }
    // Everything is wrong with these requests; the first check that fails wins.
    assert!(code(r, fresh(), stranger, now: T0 + 40 * DAY) == 3)
    assert!(code(r, fresh(), agent, now: T0 + 40 * DAY) == 5)
    r.active.paused = true
    assert!(code(r, fresh(), agent, now: T0 + 40 * DAY) == 2)
    // A stranger is told "not the agent" and nothing else, paused or not.
    assert!(code(r, fresh(), stranger, now: T0 + 40 * DAY) == 3)
    r.schedule.window_secs = secs(0)
    assert!(code(r, fresh(), stranger, now: T0 + 40 * DAY) == 1)
}

#[test]
fn each_refusal_has_its_own_code() {
    let r = rules()
    assert!(
        code(r, fresh(), ask(amount: 4, nonce: 0), now: T0 - 1) == 4,
    )
    assert!(
        code(
                r,
                fresh(),
                ask(amount: 4, nonce: 0),
                now: T0 + 30 * DAY + 1,
            ) == 5,
    )
    assert!(
        code(r, fresh(), ask(amount: 4, nonce: 0), now: T0 + 30 * DAY) == 0,
    )
    assert!(code(r, fresh(), ask(amount: 4, nonce: 1), now: T0) == 6)
    assert!(code(r, fresh(), ask(amount: 0, nonce: 0), now: T0) == 8)
    let unlisted = Request { amount: 4, nonce: 0, from_agent: true, to_approved: false }
    assert!(code(r, fresh(), unlisted, now: T0) == 9)
}

#[test]
fn reasons_carry_the_number_that_explains_them() {
    let r = rules()
    assert!(
        decide(
                rules: r,
                ledger: fresh(),
                request: ask(amount: 4, nonce: 0),
                now: at(T0 - 1),
            )
                .detail(policy: policy())
            == T0 as u256,
    )
    let late = decide(
        rules: r,
        ledger: fresh(),
        request: ask(amount: 4, nonce: 0),
        now: at(T0 + 31 * DAY),
    )
    assert!(late.detail(policy: policy()) == (T0 + 30 * DAY) as u256)
    let used = Ledger { window: 0, spent: 0, next_nonce: 7 }
    assert!(
        decide(
                rules: r,
                ledger: used,
                request: ask(amount: 4, nonce: 2),
                now: at(T0),
            )
                .detail(policy: policy())
            == 7,
    )
}

#[test]
fn extreme_inputs_never_panic() {
    let wide = Rules {
        schedule: Schedule { anchor: at(0), window_secs: secs(1), cooling_secs: secs(MAX_U64) },
        active: Policy {
            per_payment: MAX_U256,
            per_window: MAX_U256,
            valid_until: at(MAX_U64),
            paused: false,
        },
        queued: Queued::none(),
    }
    let full = Ledger { window: MAX_U64, spent: MAX_U256, next_nonce: MAX_U64 }
    assert!(
        code(
                wide,
                full,
                ask(amount: MAX_U256, nonce: MAX_U64),
                now: MAX_U64,
            ) == 7,
    )
    let nearly = Ledger { window: MAX_U64, spent: MAX_U256 - 1, next_nonce: 5 }
    assert!(
        code(wide, nearly, ask(amount: 1, nonce: 5), now: MAX_U64) == 0,
    )
    assert!(
        code(wide, nearly, ask(amount: 2, nonce: 5), now: MAX_U64) == 11,
    )
    assert!(
        code(wide, fresh(), ask(amount: MAX_U256, nonce: 0), now: 0) == 0,
    )
    // A cap lowered below what is already spent leaves nothing, not an underflow.
    let lowered = Ledger { window: 0, spent: 50, next_nonce: 0 }
    let d = decide(
        rules: rules(),
        ledger: lowered,
        request: ask(amount: 1, nonce: 0),
        now: at(T0),
    )
    assert!(d.code() == 11)
    assert!(d.detail(policy: policy()) == 0)
    assert!(
        exposure(
                rules: wide,
                ledger: fresh(),
                now: at(0),
                until: at(MAX_U64),
            ) == MAX_U256,
    )
    let amended = amend(owner(), rules: wide, proposed: policy(), now: at(MAX_U64))
    assert!(!amended.queued.is_some())
}

/// The time operations saturate rather than overflow or divide by zero, so
/// they cannot make the kernel panic.
#[test]
fn time_arithmetic_is_total() {
    assert!(at(MAX_U64 - 1) + secs(5) == at(MAX_U64))
    assert!(at(3) - secs(5) == at(0))
    assert!(at(3) - at(5) == secs(0))
    assert!(at(9) - at(5) == secs(4))
    assert!(secs(9) / secs(4) == 2)
    assert!(secs(9) / secs(0) == 0)
    assert!(
        at(4) < at(5) && at(5) <= at(5) && at(6) > at(5) && at(5) >= at(5),
    )
}

// --- owner proof ----------------------------------------------------------

#[test]
fn only_the_owner_is_authorized() {
    assert!(authorize(owner: OWNER, caller: OWNER).is_some())
    assert!(authorize(owner: OWNER, caller: STRANGER).is_none())
    assert!(authorize(owner: at(5), caller: at(6)).is_none())
}

// --- approve_from ---------------------------------------------------------

#[test]
fn a_new_recipient_waits_out_the_cooling_period() {
    let s = rules().schedule
    let from = approve_from(
        owner(),
        s,
        current: at(0),
        approved: true,
        now: at(T0 + 7),
    )
    assert!(from == at(T0 + 7 + DAY))
}

#[test]
fn asking_again_does_not_restart_the_wait() {
    let s = rules().schedule
    // Still cooling.
    let cooling = at(T0 + DAY)
    assert!(
        approve_from(
                owner(),
                s,
                current: cooling,
                approved: true,
                now: at(T0 + 50),
            ) == cooling,
    )
    // Already approved.
    let approved = at(T0)
    assert!(
        approve_from(
                owner(),
                s,
                current: approved,
                approved: true,
                now: at(T0 + 9 * DAY),
            )
            == approved,
    )
}

#[test]
fn removing_a_recipient_stores_not_approved() {
    let s = rules().schedule
    assert!(
        approve_from(
                owner(),
                s,
                current: at(T0),
                approved: false,
                now: at(T0 + 1),
            ) == at(0),
    )
    assert!(
        approve_from(
                owner(),
                s,
                current: at(0),
                approved: false,
                now: at(T0 + 1),
            ) == at(0),
    )
}

// --- amend ----------------------------------------------------------------

#[test]
fn lowering_a_limit_applies_at_once() {
    let lower = Policy {
        per_payment: 3,
        per_window: 20,
        valid_until: at(T0 + 30 * DAY),
        paused: false,
    }
    let r = amend(
        owner(),
        rules: rules(),
        proposed: lower,
        now: at(T0 + 100),
    )
    assert!(r.active.per_payment == 3)
    assert!(!r.queued.is_some())
    assert!(
        code(r, fresh(), ask(amount: 4, nonce: 0), now: T0 + 100) == 10,
    )
}

#[test]
fn raising_a_limit_waits_out_the_cooling_period() {
    let higher = Policy {
        per_payment: 500,
        per_window: 1000,
        valid_until: at(T0 + 30 * DAY),
        paused: false,
    }
    let r = amend(
        owner(),
        rules: rules(),
        proposed: higher,
        now: at(T0 + 100),
    )
    assert!(r.active.per_payment == 10)
    assert!(r.active.per_window == 20)
    assert!(r.queued.effective_at == at(T0 + 100 + DAY))
    // One second before the cooling period ends the old cap still holds.
    assert!(
        code(r, fresh(), ask(amount: 500, nonce: 0), now: T0 + 99 + DAY) == 10,
    )
    assert!(
        code(
                r,
                fresh(),
                ask(amount: 500, nonce: 0),
                now: T0 + 100 + DAY,
            ) == 0,
    )
}

#[test]
fn a_mixed_change_tightens_now_and_loosens_later() {
    let mixed = Policy {
        per_payment: 2,
        per_window: 1000,
        valid_until: at(T0 + 30 * DAY),
        paused: false,
    }
    let r = amend(owner(), rules: rules(), proposed: mixed, now: at(T0))
    assert!(r.active.per_payment == 2)
    assert!(r.active.per_window == 20)
    assert!(r.queued.is_some())
    assert!(r.current(now: at(T0 + DAY)).per_window == 1000)
}

#[test]
fn a_queued_raise_can_be_cancelled() {
    let higher = Policy {
        per_payment: 500,
        per_window: 1000,
        valid_until: at(T0 + 30 * DAY),
        paused: false,
    }
    let queued = amend(owner(), rules: rules(), proposed: higher, now: at(T0))
    let r = cancel(owner(), rules: queued, now: at(T0 + 50))
    assert!(!r.queued.is_some())
    assert!(
        code(r, fresh(), ask(amount: 500, nonce: 0), now: T0 + 2 * DAY) == 10,
    )
}

#[test]
fn pausing_is_instant_and_cancels_a_queued_raise() {
    let higher = Policy {
        per_payment: 500,
        per_window: 1000,
        valid_until: at(T0 + 30 * DAY),
        paused: false,
    }
    let queued = amend(owner(), rules: rules(), proposed: higher, now: at(T0))
    var stop = queued.active
    stop.paused = true
    let r = amend(owner(), rules: queued, proposed: stop, now: at(T0 + 10))
    assert!(r.active.paused)
    assert!(!r.queued.is_some())
    assert!(
        code(r, fresh(), ask(amount: 1, nonce: 0), now: T0 + 10) == 2,
    )
    assert!(
        code(r, fresh(), ask(amount: 1, nonce: 0), now: T0 + 5 * DAY) == 2,
    )
}

#[test]
fn resuming_waits_out_the_cooling_period() {
    var paused = rules()
    paused.active.paused = true
    let r = amend(owner(), rules: paused, proposed: policy(), now: at(T0))
    assert!(r.active.paused)
    assert!(
        code(r, fresh(), ask(amount: 1, nonce: 0), now: T0 + DAY - 1) == 2,
    )
    assert!(
        code(r, fresh(), ask(amount: 1, nonce: 0), now: T0 + DAY) == 0,
    )
}

#[test]
fn loosens_and_meet_agree() {
    let a = policy()
    let b = Policy { per_payment: 11, per_window: 5, valid_until: at(T0), paused: true }
    assert!(loosens(a, to: b))
    assert!(loosens(b, to: a))
    let m = meet(a, b)
    assert!(!loosens(a, to: m))
    assert!(!loosens(b, to: m))
    assert!(
        m.per_payment == 10 && m.per_window == 5 && m.valid_until == at(T0) && m.paused,
    )
}

// --- exposure -------------------------------------------------------------

#[test]
fn exposure_counts_whole_windows() {
    let r = rules()
    // The rest of today.
    assert!(
        exposure(
                rules: r,
                ledger: fresh(),
                now: at(T0),
                until: at(T0 + DAY - 1),
            ) == 20,
    )
    // Today and tomorrow.
    assert!(
        exposure(
                rules: r,
                ledger: fresh(),
                now: at(T0),
                until: at(T0 + DAY),
            ) == 40,
    )
    // What was already spent today comes off today only.
    let used = Ledger { window: 0, spent: 15, next_nonce: 1 }
    assert!(
        exposure(
                rules: r,
                ledger: used,
                now: at(T0 + 5),
                until: at(T0 + DAY),
            ) == 25,
    )
}

#[test]
fn exposure_is_zero_when_nothing_can_move() {
    var r = rules()
    assert!(
        exposure(
                rules: r,
                ledger: fresh(),
                now: at(T0 + 31 * DAY),
                until: at(T0 + 40 * DAY),
            ) == 0,
    )
    assert!(
        exposure(
                rules: r,
                ledger: fresh(),
                now: at(T0 + 5),
                until: at(T0 + 4),
            ) == 0,
    )
    r.active.paused = true
    assert!(
        exposure(
                rules: r,
                ledger: fresh(),
                now: at(T0),
                until: at(T0 + 10 * DAY),
            ) == 0,
    )
}

#[test]
fn exposure_stops_at_expiry() {
    var r = rules()
    r.active.valid_until = at(T0 + DAY + 5)
    assert!(
        exposure(
                rules: r,
                ledger: fresh(),
                now: at(T0),
                until: at(T0 + 10 * DAY),
            ) == 40,
    )
}

#[test]
fn exposure_includes_a_raise_that_matures_in_time() {
    let higher = Policy {
        per_payment: 500,
        per_window: 1000,
        valid_until: at(T0 + 30 * DAY),
        paused: false,
    }
    let r = amend(owner(), rules: rules(), proposed: higher, now: at(T0))
    // Inside the cooling period the raise changes nothing.
    assert!(
        exposure(
                rules: r,
                ledger: fresh(),
                now: at(T0),
                until: at(T0 + DAY - 1),
            ) == 20,
    )
    // One second later it is in force for that second's window.
    assert!(
        exposure(
                rules: r,
                ledger: fresh(),
                now: at(T0),
                until: at(T0 + DAY),
            ) == 1020,
    )
}

// --- found by review -------------------------------------------------------
// Each of these pins a behaviour that an independent adversarial review
// showed the suite did not pin before.

fn higher() -> Policy {
    Policy { per_payment: 500, per_window: 1000, valid_until: at(T0 + 30 * DAY), paused: false }
}

#[test]
fn proposing_again_restarts_the_wait() {
    let first = amend(owner(), rules: rules(), proposed: higher(), now: at(T0))
    var bigger = higher()
    bigger.per_payment = 100000
    bigger.per_window = 100000
    let second = amend(
        owner(),
        rules: first,
        proposed: bigger,
        now: at(T0 + DAY - 1),
    )
    // The bigger raise waits its own full cooling period.
    assert!(second.queued.effective_at == at(T0 + 2 * DAY - 1))
    // And the smaller one it replaced does not arrive on its old schedule.
    assert!(
        code(second, fresh(), ask(amount: 11, nonce: 0), now: T0 + DAY) == 10,
    )
}

#[test]
fn a_matured_raise_is_the_baseline_for_the_next_proposal() {
    let first = amend(owner(), rules: rules(), proposed: higher(), now: at(T0))
    // Two days later the raise is in force. Lowering one field of it is a
    // tightening, so it applies at once and nothing is queued.
    var lower = higher()
    lower.per_payment = 50
    let second = amend(
        owner(),
        rules: first,
        proposed: lower,
        now: at(T0 + 2 * DAY),
    )
    assert!(
        second.active.per_payment == 50 && second.active.per_window == 1000,
    )
    assert!(!second.queued.is_some())
    // Cancelling after the raise took effect keeps it: there is nothing left to cancel.
    let kept = cancel(owner(), rules: first, now: at(T0 + 2 * DAY))
    assert!(kept.active.per_payment == 500 && !kept.queued.is_some())
}

#[test]
fn exposure_uses_a_raise_that_already_took_effect() {
    let raised = amend(owner(), rules: rules(), proposed: higher(), now: at(T0))
    assert!(
        exposure(
                rules: raised,
                ledger: fresh(),
                now: at(T0 + 2 * DAY),
                until: at(T0 + 2 * DAY),
            )
            == 1000,
    )
}

#[test]
fn exposure_ignores_spending_from_an_older_window() {
    let stale = Ledger { window: 0, spent: 15, next_nonce: 1 }
    assert!(
        exposure(
                rules: rules(),
                ledger: stale,
                now: at(T0 + DAY),
                until: at(T0 + 2 * DAY - 1),
            )
            == 20,
    )
    var zero = rules()
    zero.active.per_payment = 0
    assert!(
        exposure(
                rules: zero,
                ledger: fresh(),
                now: at(T0),
                until: at(T0 + DAY),
            ) == 0,
    )
}

/// If the cooling period would end after the last representable second, the
/// raise never takes effect. Rounding it down to that second would cut the
/// wait short.
#[test]
fn a_raise_that_would_mature_past_the_end_of_time_never_does() {
    let late = Rules {
        schedule: Schedule {
            anchor: at(MAX_U64 - 1000),
            window_secs: secs(DAY),
            cooling_secs: secs(DAY),
        },
        active: Policy { per_payment: 10, per_window: 20, valid_until: at(MAX_U64), paused: false },
        queued: Queued::none(),
    }
    let forever = Policy {
        per_payment: 500,
        per_window: 1000,
        valid_until: at(MAX_U64),
        paused: false,
    }
    let bound = exposure(
        rules: late,
        ledger: fresh(),
        now: at(MAX_U64 - 5),
        until: at(MAX_U64),
    )
    assert!(bound == 20)
    let r = amend(
        owner(),
        rules: late,
        proposed: forever,
        now: at(MAX_U64 - 5),
    )
    assert!(r.queued.effective_at == at(MAX_U64))
    assert!(
        code(r, fresh(), ask(amount: 500, nonce: 0), now: MAX_U64) == 10,
    )
    assert!(
        exposure(
                rules: r,
                ledger: fresh(),
                now: at(MAX_U64 - 5),
                until: at(MAX_U64),
            ) == 20,
    )
    let at_the_end = amend(owner(), rules: late, proposed: forever, now: at(MAX_U64))
    assert!(
        code(
                at_the_end,
                fresh(),
                ask(amount: 500, nonce: 0),
                now: MAX_U64,
            ) == 10,
    )
}

/// `exposure` is exact only while sequence numbers remain. With the counter
/// used up nothing can be paid, and the bound is merely an upper bound.
#[test]
fn exposure_is_only_an_upper_bound_once_sequence_numbers_run_out() {
    let dead = Ledger { window: 0, spent: 0, next_nonce: MAX_U64 }
    assert!(
        exposure(
                rules: rules(),
                ledger: dead,
                now: at(T0),
                until: at(T0 + 10),
            ) == 20,
    )
    assert!(
        code(rules(), dead, ask(amount: 1, nonce: MAX_U64), now: T0) == 7,
    )
}

/// The promise "whatever the owner signs" assumes the queue came from
/// `amend`, which never queues something tighter than the active policy.
/// Rules built by hand with a tighter queue break it: cancelling loosens.
/// The vault cannot reach this state; the command-line tool can be given it.
#[test]
fn exposure_owner_promise_needs_a_queue_built_by_amend() {
    let by_hand = Rules {
        schedule: Schedule { anchor: at(T0), window_secs: secs(3600), cooling_secs: secs(DAY) },
        active: policy(),
        queued: Queued { policy: Queued::none().policy, effective_at: at(T0 + 10) },
    }
    let until = at(T0 + DAY - 1)
    assert!(
        exposure(rules: by_hand, ledger: fresh(), now: at(T0), until) == 20,
    )
    let after_cancel = cancel(owner(), rules: by_hand, now: at(T0 + 5))
    assert!(
        exposure(
                rules: after_cancel,
                ledger: fresh(),
                now: at(T0 + 5),
                until,
            ) == 480,
    )
    // Whereas after any `amend`, the active policy is never looser than the queue.
    let amended = amend(owner(), rules: rules(), proposed: higher(), now: at(T0))
    assert!(!loosens(amended.queued.policy, to: amended.active))
}

/// A raise the owner never wanted, cancelled in the last second before it
/// would take effect: the old cap stays, then and later.
#[test]
fn cancelling_a_raise_in_its_last_second_keeps_the_old_cap() {
    let rules = Rules {
        schedule: Schedule {
            anchor: Instant::at(T0),
            window_secs: Seconds::of(DAY),
            cooling_secs: Seconds::of(DAY),
        },
        active: Policy {
            per_payment: 10,
            per_window: 20,
            valid_until: Instant::at(T0 + 30 * DAY),
            paused: false,
        },
        queued: Queued::none(),
    }
    let raise = Policy {
        per_payment: 500,
        per_window: 1000,
        valid_until: Instant::at(T0 + 30 * DAY),
        paused: false,
    }
    let waiting = amend(owner(), rules, proposed: raise, now: Instant::at(T0))
    let cancelled = cancel(owner(), rules: waiting, now: Instant::at(T0 + DAY - 1))
    assert!(!cancelled.queued.is_some())
    for at in [T0 + DAY - 1, T0 + DAY, T0 + 5 * DAY] {
        assert!(cancelled.current(now: Instant::at(at)).per_payment == 10)
    }
}

/// A recipient added by mistake and removed while it is still cooling is
/// never payable: removal is instant, like any tightening.
#[test]
fn removing_a_recipient_while_it_cools_is_instant() {
    let schedule = Schedule {
        anchor: Instant::at(T0),
        window_secs: Seconds::of(DAY),
        cooling_secs: Seconds::of(DAY),
    }
    let pending = approve_from(
        owner(),
        schedule,
        current: Instant::at(0),
        approved: true,
        now: Instant::at(T0),
    )
    assert!(pending == Instant::at(T0 + DAY))
    let removed = approve_from(
        owner(),
        schedule,
        current: pending,
        approved: false,
        now: Instant::at(T0 + 10),
    )
    assert!(removed == Instant::at(0))
}

/// Every day from 2020 to 2040, at a different second of each day, the
/// caps hold and a raise waits the whole cooling period. Every other test
/// here runs near second 1,000,000, so without this a kernel that only
/// misbehaved on dates around today would pass them all. (The campaign in
/// `adversary_tests.fe` also samples such dates, at random.)
#[test]
fn the_caps_and_the_cooling_period_hold_on_every_day_from_2020_to_2040() {
    let start: u64 = 1577836800
    let dated = Rules {
        schedule: Schedule { anchor: at(start), window_secs: secs(DAY), cooling_secs: secs(DAY) },
        active: Policy {
            per_payment: 10,
            per_window: 20,
            valid_until: at(start + 7400 * DAY),
            paused: false,
        },
        queued: Queued::none(),
    }
    let raise = Policy {
        per_payment: 50,
        per_window: 100,
        valid_until: at(start + 7400 * DAY),
        paused: false,
    }
    var day: u64 = 0
    while day < 7306 {
        let now = start + day * DAY + (day * 7919) % DAY
        let spent = Ledger { window: day, spent: 15, next_nonce: 0 }
        assert!(code(dated, fresh(), ask(amount: 11, nonce: 0), now) == 10)
        assert!(code(dated, spent, ask(amount: 6, nonce: 0), now) == 11)
        let raised = amend(owner(), rules: dated, proposed: raise, now: at(now))
        assert!(raised.queued.effective_at == at(now + DAY))
        day = day + 1
    }
}
