//! HARDSTOP policy kernel.
//!
//! Everything in this module is pure: no function has a `uses` clause, so the
//! compiler guarantees that none of it can read storage, make a call, emit a
//! log, or touch a file. The same source is compiled into the EVM vault
//! (`ingot::vault`) and into the native tool (`pub fn main`), so a prediction
//! made off-chain and the verdict reached on-chain are the same code.
//!
//! Every function here is total: no input makes it panic or overflow.
//!
//! Three ideas live here:
//!
//! 1. `decide`: may this payment go through, and if not, why not?
//! 2. `amend`: the owner changes the rules. Tightening applies at once;
//!    loosening waits out a cooling period and can be cancelled meanwhile.
//! 3. `exposure`: the most that can leave through the agent between two
//!    moments, whatever the agent does.
//!
//! Every function that changes the rules takes an `OwnerProof`, and
//! `authorize` is the only way to get one. See `OwnerProof` for what that
//! does and does not prove.
//!
//! The values here are plain, so that tests, the adversary and the native
//! tool can build any state they like. The vault does not use them that way:
//! it holds the sealed types of `kernel::sealed` (EVM only), the one module
//! that reads the caller, and it can change its rules only through them.

/// A moment, in Unix seconds.
pub struct Instant { secs: u64 }

/// A length of time, in seconds.
pub struct Seconds { secs: u64 }

impl Copy for Instant {}
impl Copy for Seconds {}

impl Instant {
    pub fn at(_ secs: u64) -> Instant {
        Instant { secs }
    }

    pub const fn secs(self) -> u64 {
        self.secs
    }
}

impl Seconds {
    pub fn of(_ secs: u64) -> Seconds {
        Seconds { secs }
    }

    pub const fn secs(self) -> u64 {
        self.secs
    }
}

/// Saturates at the last representable second, which `cooled` treats as
/// never.
impl core::ops::Add<Seconds> for Instant {
    const fn add(own self, _ other: own Seconds) -> Instant {
        Instant { secs: self.secs.saturating_add(other.secs) }
    }
}

/// Saturates at second zero.
impl core::ops::Sub<Seconds> for Instant {
    const fn sub(own self, _ other: own Seconds) -> Instant {
        Instant { secs: self.secs.saturating_sub(other.secs) }
    }
}

/// The time from `other` to `self`; zero if `other` is later.
impl core::ops::Sub<Instant> for Instant {
    type Output = Seconds
    const fn sub(own self, _ other: own Instant) -> Seconds {
        Seconds { secs: self.secs.saturating_sub(other.secs) }
    }
}

/// How many whole `other`s fit in `self`; zero when `other` is zero.
impl core::ops::Div<Seconds> for Seconds {
    type Output = u64
    const fn div(own self, _ other: own Seconds) -> u64 {
        if other.secs == 0 {
            0
        } else {
            self.secs / other.secs
        }
    }
}

impl core::ops::Eq for Instant {
    const fn eq(self, _ other: Instant) -> bool {
        self.secs == other.secs
    }
    const fn ne(self, _ other: Instant) -> bool {
        self.secs != other.secs
    }
}

impl core::ops::Ord for Instant {
    const fn lt(self, _ other: Instant) -> bool {
        self.secs < other.secs
    }
    const fn le(self, _ other: Instant) -> bool {
        self.secs <= other.secs
    }
    const fn gt(self, _ other: Instant) -> bool {
        self.secs > other.secs
    }
    const fn ge(self, _ other: Instant) -> bool {
        self.secs >= other.secs
    }
}

impl core::ops::Eq for Seconds {
    const fn eq(self, _ other: Seconds) -> bool {
        self.secs == other.secs
    }
    const fn ne(self, _ other: Seconds) -> bool {
        self.secs != other.secs
    }
}

/// Evidence that `authorize` was called and its two arguments were equal.
///
/// What the compiler guarantees:
/// - `granted` is not `pub`, so no code outside this module can write
///   `OwnerProof { .. }` (refused as "not visible"); `authorize` is the only
///   way to get one.
/// - It is not `Copy`, and every function that takes one takes it `own`, so
///   a proof is spent by its first use (a second use is refused as "use
///   after move").
/// - `#[must_use]`: a proof that is made and dropped is refused.
///
/// What it does not guarantee: that the arguments to `authorize` were the
/// real owner and the real caller. `authorize` is public, so code that can
/// call it can pass the same value twice and get a proof for anyone. That is
/// what the tests and the adversary do. The vault cannot use such a proof:
/// what it calls takes a `sealed::OwnerCall`, which only `sealed::prove`
/// makes, from the real caller.
#[must_use]
pub struct OwnerProof { granted: bool }

/// An `OwnerProof` when `caller` is `owner`, nothing otherwise.
#[must_use]
pub fn authorize<T: core::ops::Eq>(owner: T, caller: T) -> Option<OwnerProof> {
    if caller == owner {
        Option::Some(OwnerProof { granted: true })
    } else {
        Option::None
    }
}

/// The rules the owner may change. Amounts are token base units.
pub struct Policy {
    /// Largest single payment.
    pub per_payment: u256,
    /// Largest total inside one window.
    pub per_window: u256,
    /// Last second at which the agent may still pay.
    pub valid_until: Instant,
    /// Owner's stop switch.
    pub paused: bool,
}

/// What is fixed when a vault is created and never changes.
pub struct Schedule {
    /// Start of window 0. Windows are fixed, not rolling.
    pub anchor: Instant,
    /// Window length. Zero makes every request invalid.
    pub window_secs: Seconds,
    /// How long a loosening waits before it takes effect.
    pub cooling_secs: Seconds,
}

/// A loosening that is waiting out its cooling period.
/// `effective_at` second zero means nothing is queued.
pub struct Queued { pub policy: Policy, pub effective_at: Instant }

/// Everything the owner controls.
pub struct Rules { pub schedule: Schedule, pub active: Policy, pub queued: Queued }

/// What the vault remembers between payments.
pub struct Ledger {
    /// Index of the window `spent` belongs to.
    pub window: u64,
    /// Total paid inside that window.
    pub spent: u256,
    /// Sequence number the next payment must carry.
    pub next_nonce: u64,
}

/// One payment request, reduced to the facts the decision depends on. The
/// caller (vault or simulator) resolves "who is asking" and "is the recipient
/// approved by now" and passes the answers in.
pub struct Request { pub amount: u256, pub nonce: u64, pub from_agent: bool, pub to_approved: bool }

/// Why a request was refused. Variants carry the number a person needs to
/// understand the refusal.
pub enum Reason {
    /// The vault's schedule has a zero-length window.
    InvalidPolicy,
    /// The owner paused the agent.
    Paused,
    /// The caller is not the delegated agent.
    NotAgent,
    /// The schedule starts at the carried time.
    NotYetActive(Instant),
    /// The policy ended at the carried time.
    Expired(Instant),
    /// The request reused or skipped a sequence number; carries the expected one.
    WrongNonce(u64),
    /// The sequence counter is used up.
    NonceExhausted,
    /// A payment of nothing.
    ZeroAmount,
    /// The recipient is not approved, or its approval is still cooling.
    RecipientNotApproved,
    /// Above the single-payment cap; carries the cap.
    OverPaymentLimit(u256),
    /// Above what is left in this window; carries what is left.
    OverWindowLimit(u256),
}

/// The verdict. `Allow` carries the ledger to store once the payment is made.
pub enum Decision {
    Allow(Ledger),
    Deny(Reason),
}

impl Copy for Policy {}
impl Copy for Schedule {}
impl Copy for Queued {}
impl Copy for Rules {}
impl Copy for Ledger {}
impl Copy for Request {}
impl Copy for Reason {}
impl Copy for Decision {}

const MAX_U64: u64 = 18446744073709551615
/// "Nothing scheduled".
const NOT_SET: Instant = Instant { secs: 0 }
/// The last representable second: a change scheduled for it never happens.
const NEVER: Instant = Instant { secs: MAX_U64 }

/// Wire codes for a verdict. The vault returns them from `pay` and logs them,
/// the native tool prints them and the web app names them, so they must never
/// shift. The compiler checks the constants: 0 is "allowed" and each refusal
/// is the one before it plus one, so no two constants collide and none is
/// skipped; editing one into a duplicate fails to build
/// (`scripts/pay-cannot-loosen.sh`). It does not check that each `Reason`
/// below uses its own constant; the tests on each reason's code do that.
pub const CODE_ALLOWED: u8 = 0
pub const CODE_INVALID_POLICY: u8 = 1
pub const CODE_PAUSED: u8 = 2
pub const CODE_NOT_AGENT: u8 = 3
pub const CODE_NOT_YET_ACTIVE: u8 = 4
pub const CODE_EXPIRED: u8 = 5
pub const CODE_WRONG_NONCE: u8 = 6
pub const CODE_NONCE_EXHAUSTED: u8 = 7
pub const CODE_ZERO_AMOUNT: u8 = 8
pub const CODE_RECIPIENT_NOT_APPROVED: u8 = 9
pub const CODE_OVER_PAYMENT_LIMIT: u8 = 10
pub const CODE_OVER_WINDOW_LIMIT: u8 = 11

static_assert(CODE_ALLOWED == 0)
static_assert(CODE_INVALID_POLICY == CODE_ALLOWED + 1)
static_assert(CODE_PAUSED == CODE_INVALID_POLICY + 1)
static_assert(CODE_NOT_AGENT == CODE_PAUSED + 1)
static_assert(CODE_NOT_YET_ACTIVE == CODE_NOT_AGENT + 1)
static_assert(CODE_EXPIRED == CODE_NOT_YET_ACTIVE + 1)
static_assert(CODE_WRONG_NONCE == CODE_EXPIRED + 1)
static_assert(CODE_NONCE_EXHAUSTED == CODE_WRONG_NONCE + 1)
static_assert(CODE_ZERO_AMOUNT == CODE_NONCE_EXHAUSTED + 1)
static_assert(CODE_RECIPIENT_NOT_APPROVED == CODE_ZERO_AMOUNT + 1)
static_assert(CODE_OVER_PAYMENT_LIMIT == CODE_RECIPIENT_NOT_APPROVED + 1)
static_assert(CODE_OVER_WINDOW_LIMIT == CODE_OVER_PAYMENT_LIMIT + 1)

impl Reason {
    /// Stable wire code. `0` is reserved for "allowed".
    pub fn code(self) -> u8 {
        match self {
            Reason::InvalidPolicy => CODE_INVALID_POLICY,
            Reason::Paused => CODE_PAUSED,
            Reason::NotAgent => CODE_NOT_AGENT,
            Reason::NotYetActive(_) => CODE_NOT_YET_ACTIVE,
            Reason::Expired(_) => CODE_EXPIRED,
            Reason::WrongNonce(_) => CODE_WRONG_NONCE,
            Reason::NonceExhausted => CODE_NONCE_EXHAUSTED,
            Reason::ZeroAmount => CODE_ZERO_AMOUNT,
            Reason::RecipientNotApproved => CODE_RECIPIENT_NOT_APPROVED,
            Reason::OverPaymentLimit(_) => CODE_OVER_PAYMENT_LIMIT,
            Reason::OverWindowLimit(_) => CODE_OVER_WINDOW_LIMIT,
        }
    }

    /// The number carried by the reason, or zero.
    pub fn detail(self) -> u256 {
        match self {
            Reason::NotYetActive(at) => at.secs() as u256,
            Reason::Expired(at) => at.secs() as u256,
            Reason::WrongNonce(expected) => expected as u256,
            Reason::OverPaymentLimit(limit) => limit,
            Reason::OverWindowLimit(left) => left,
            _ => 0,
        }
    }
}

impl Decision {
    /// `0` when allowed, otherwise the reason code.
    pub fn code(self) -> u8 {
        match self {
            Decision::Allow(_) => CODE_ALLOWED,
            Decision::Deny(reason) => reason.code(),
        }
    }

    /// When allowed: what is left in the window after this payment.
    /// When denied: the reason's detail.
    pub fn detail(self, policy: Policy) -> u256 {
        match self {
            Decision::Allow(next) => left_in_window(policy, spent: next.spent),
            Decision::Deny(reason) => reason.detail(),
        }
    }
}

impl Queued {
    /// The empty queue.
    pub fn none() -> Queued {
        Queued {
            policy: Policy { per_payment: 0, per_window: 0, valid_until: NOT_SET, paused: true },
            effective_at: NOT_SET,
        }
    }

    pub const fn is_some(self) -> bool {
        self.effective_at != NOT_SET
    }

    /// Whether the queued policy is in force at `now`.
    pub const fn matured(self, now: Instant) -> bool {
        cooled(at: self.effective_at, now)
    }
}

/// Whether something that takes effect at `at` is in effect at `now`.
///
/// Zero means "nothing scheduled". The last representable second means "the
/// cooling period ran past the end of time", and such a change never takes
/// effect: rounding it down to that last second would cut the wait short.
pub const fn cooled(at: Instant, now: Instant) -> bool {
    at != NOT_SET && at != NEVER && now >= at
}

impl Rules {
    /// The policy in force at `now`: the queued one once its cooling period
    /// is over, the active one before that.
    pub const fn current(self, now: Instant) -> Policy {
        if self.queued.matured(now) {
            self.queued.policy
        } else {
            self.active
        }
    }
}

/// Cap minus spent, floored at zero. A cap lowered below what was already
/// spent leaves nothing rather than underflowing.
pub fn left_in_window(_ policy: Policy, spent: u256) -> u256 {
    if spent >= policy.per_window {
        0
    } else {
        policy.per_window - spent
    }
}

/// Index of the fixed window that contains `at`. Requires a non-zero window
/// length and `at >= schedule.anchor`; callers check both first.
fn window_at(_ schedule: Schedule, at: Instant) -> u64 {
    (at - schedule.anchor) / schedule.window_secs
}

/// Decide one request. Checks run in a fixed order, so the same inputs always
/// give the same reason.
pub fn decide(rules: Rules, ledger: Ledger, request: Request, now: Instant) -> Decision {
    let schedule = rules.schedule
    let policy = rules.current(now)

    if schedule.window_secs == Seconds::of(0) {
        return Decision::Deny(Reason::InvalidPolicy)
    }
    // Who is asking comes before anything about the rules: a stranger learns
    // nothing about the vault's state and, in the vault, gets a revert.
    if !request.from_agent {
        return Decision::Deny(Reason::NotAgent)
    }
    if policy.paused {
        return Decision::Deny(Reason::Paused)
    }
    if now < schedule.anchor {
        return Decision::Deny(Reason::NotYetActive(schedule.anchor))
    }
    if now > policy.valid_until {
        return Decision::Deny(Reason::Expired(policy.valid_until))
    }
    if request.nonce != ledger.next_nonce {
        return Decision::Deny(Reason::WrongNonce(ledger.next_nonce))
    }
    if ledger.next_nonce == MAX_U64 {
        return Decision::Deny(Reason::NonceExhausted)
    }
    if request.amount == 0 {
        return Decision::Deny(Reason::ZeroAmount)
    }
    if !request.to_approved {
        return Decision::Deny(Reason::RecipientNotApproved)
    }
    if request.amount > policy.per_payment {
        return Decision::Deny(Reason::OverPaymentLimit(policy.per_payment))
    }

    let window = window_at(schedule, at: now)
    let spent: u256 = if window == ledger.window {
        ledger.spent
    } else {
        0
    }
    let left = left_in_window(policy, spent)
    if request.amount > left {
        return Decision::Deny(Reason::OverWindowLimit(left))
    }

    // `amount <= left <= per_window - spent`, so the sum cannot overflow.
    Decision::Allow(
        Ledger { window, spent: spent + request.amount, next_nonce: ledger.next_nonce + 1 },
    )
}

/// Whether `to` lets the agent do anything `from` does not.
pub const fn loosens(_ from: Policy, to: Policy) -> bool {
    to.per_payment > from.per_payment
        || to.per_window > from.per_window
        || to.valid_until > from.valid_until
        || (from.paused && !to.paused)
}

/// The tightest of two policies, field by field.
pub const fn meet(_ a: Policy, _ b: Policy) -> Policy {
    Policy {
        per_payment: if a.per_payment < b.per_payment {
            a.per_payment
        } else {
            b.per_payment
        },
        per_window: if a.per_window < b.per_window {
            a.per_window
        } else {
            b.per_window
        },
        valid_until: if a.valid_until < b.valid_until {
            a.valid_until
        } else {
            b.valid_until
        },
        paused: a.paused || b.paused,
    }
}

/// The owner proposes `proposed` at `now`.
///
/// Whatever in the proposal is tighter than the policy in force applies
/// immediately. If any part is looser, the whole proposal is queued and
/// takes effect `cooling_secs` later; a proposal with nothing looser clears
/// the queue. So a limit can drop in one step but can only rise after the
/// cooling period, and any later tightening cancels a pending rise.
pub fn amend(_ proof: own OwnerProof, rules: Rules, proposed: Policy, now: Instant) -> Rules {
    let in_force = rules.current(now)
    let active = meet(in_force, proposed)
    let queued = if loosens(active, to: proposed) {
        Queued { policy: proposed, effective_at: matures_at(rules.schedule, now) }
    } else {
        Queued::none()
    }
    Rules { schedule: rules.schedule, active, queued }
}

/// Drop a queued loosening that has not taken effect yet. One that already
/// has is the policy in force and stays.
pub fn cancel(_ proof: own OwnerProof, rules: Rules, now: Instant) -> Rules {
    Rules { schedule: rules.schedule, active: rules.current(now), queued: Queued::none() }
}

/// The owner approves or removes a recipient at `now`; the result is the
/// moment from which it may be paid. `current` is what is stored for it now.
///
/// Removing stores second zero ("not approved"). Approving one that is
/// already approved or already cooling keeps its moment, so asking again
/// does not restart the wait. Anything else waits out the cooling period.
pub fn approve_from(
    _ proof: own OwnerProof,
    _ schedule: Schedule,
    current: Instant,
    approved: bool,
    now: Instant,
) -> Instant {
    if !approved {
        NOT_SET
    } else if current != NOT_SET {
        current
    } else {
        matures_at(schedule, now)
    }
}

/// When something loosened at `now` takes effect: `now + cooling_secs`,
/// never zero (zero means "nothing queued"). If that would be past the end
/// of time it is the last second, which `cooled` treats as never.
pub fn matures_at(_ schedule: Schedule, now: Instant) -> Instant {
    // `+` saturates at `NEVER`, the last second.
    let at = now + schedule.cooling_secs
    if at == NOT_SET { Instant::at(1) } else { at }
}

/// The most the agent can move between `now` and `until`, both inclusive,
/// given the rules and ledger as they stand at `now`.
///
/// This holds whatever the agent does. It also holds whatever the owner
/// signs during that time as long as `until < now + cooling_secs`, because
/// nothing proposed after `now` can loosen the rules before then.
///
/// With nothing queued the bound is exact: an agent with an approved
/// recipient, enough balance and sequence numbers left can reach it. With a
/// loosening that matures inside the interval it is an upper bound.
///
/// Two things it does not look at: the vault's balance (it says what the
/// rules allow, not what is there to take), and where `rules` came from. The
/// promise about the owner assumes the queue was produced by `amend`, which
/// only ever queues something looser than the active policy. Hand-built
/// rules with a tighter queue would make `cancel` a loosening.
pub fn exposure(rules: Rules, ledger: Ledger, now: Instant, until: Instant) -> u256 {
    if rules.schedule.window_secs == Seconds::of(0) || until < now {
        return 0
    }
    let queued = rules.queued
    if !cooled(at: queued.effective_at, now: until) {
        // Nothing queued, or nothing that takes effect by `until`.
        return span(rules.schedule, rules.active, ledger, from: now, to: until)
    }
    if queued.matured(now) {
        return span(
            rules.schedule,
            queued.policy,
            ledger,
            from: now,
            to: until,
        )
    }
    let before = span(
        rules.schedule,
        rules.active,
        ledger,
        from: now,
        to: queued.effective_at - Seconds::of(1),
    )
    // After the switch, assume the new policy's windows start empty.
    let empty = Ledger { window: MAX_U64, spent: 0, next_nonce: 0 }
    let after_switch = span(
        rules.schedule,
        queued.policy,
        empty,
        from: queued.effective_at,
        to: until,
    )
    before.saturating_add(after_switch)
}

/// The most one policy lets through between `from` and `to`, inclusive.
fn span(
    _ schedule: Schedule,
    _ policy: Policy,
    _ ledger: Ledger,
    from: Instant,
    to: Instant,
) -> u256 {
    if policy.paused || policy.per_payment == 0 {
        return 0
    }
    let start = if from > schedule.anchor {
        from
    } else {
        schedule.anchor
    }
    let end = if to < policy.valid_until {
        to
    } else {
        policy.valid_until
    }
    if end < start { return 0 }
    let first = window_at(schedule, at: start)
    let last = window_at(schedule, at: end)
    let spent: u256 = if first == ledger.window {
        ledger.spent
    } else {
        0
    }
    let later_windows: u256 = (last - first) as u256
    left_in_window(policy, spent).saturating_add(policy.per_window.saturating_mul(later_windows))
}

// The ratchet's laws, checked by the compiler.
//
// Each `static_assert` below is evaluated while the kernel compiles: the
// compiler runs the `const fn`s above (`loosens`, `meet`, `cooled`,
// `Rules::current` and the `Instant` and `Seconds` operators) on the
// constants here, and a false one stops the build with "static assertion
// failed" (8-0081). They check these representative cases, chosen to include
// zero and the extremes, not every input; the tests and the seeded adversary
// cover breadth.
//
// `amend`, `cancel` and `matures_at` are not `const fn`, so nothing here runs
// them. Making them `const` changes the compiled vault, and with it the
// launcher's deterministic address. What is checked is the rule `amend` is
// built on: the active policy becomes `meet(in force, proposed)`, and the
// proposal is queued exactly when `loosens(that, to: proposed)`.

/// Neither policy lets the agent do anything the other does not.
const fn same(_ a: Policy, _ b: Policy) -> bool {
    !loosens(a, to: b) && !loosens(b, to: a)
}

const MAX_U256: u256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935
/// Nothing allowed: the tightest policy there is.
const SHUT: Policy = Policy { per_payment: 0, per_window: 0, valid_until: NOT_SET, paused: true }
/// Everything allowed: the loosest.
const OPEN: Policy = Policy {
    per_payment: MAX_U256,
    per_window: MAX_U256,
    valid_until: NEVER,
    paused: false,
}
const P1: Policy = Policy {
    per_payment: 100,
    per_window: 1000,
    valid_until: Instant { secs: 500 },
    paused: false,
}
/// Looser than `P1` per payment; tighter per window and in time, and paused.
const P2: Policy = Policy {
    per_payment: 200,
    per_window: 800,
    valid_until: Instant { secs: 300 },
    paused: true,
}
/// Looser than `P1` per window and in time.
const P3: Policy = Policy {
    per_payment: 100,
    per_window: 5000,
    valid_until: Instant { secs: 900 },
    paused: false,
}
/// `P1` loosened in one field each.
const P1_PAY: Policy = Policy {
    per_payment: 101,
    per_window: 1000,
    valid_until: Instant { secs: 500 },
    paused: false,
}
const P1_WINDOW: Policy = Policy {
    per_payment: 100,
    per_window: 1001,
    valid_until: Instant { secs: 500 },
    paused: false,
}
const P1_LATER: Policy = Policy {
    per_payment: 100,
    per_window: 1000,
    valid_until: Instant { secs: 501 },
    paused: false,
}
/// `P1` tightened in one field: paused.
const P1_PAUSED: Policy = Policy {
    per_payment: 100,
    per_window: 1000,
    valid_until: Instant { secs: 500 },
    paused: true,
}

const ONE: Instant = Instant { secs: 1 }
const AT: Instant = Instant { secs: 1000 }
const SECOND: Seconds = Seconds { secs: 1 }
const NO_TIME: Seconds = Seconds { secs: 0 }
const HOUR: Seconds = Seconds { secs: 3600 }
const FOREVER: Seconds = Seconds { secs: MAX_U64 }
/// `P1` in force with `P3` queued to take effect an hour after `AT`.
const RAISING: Rules = Rules {
    schedule: Schedule {
        anchor: NOT_SET,
        window_secs: Seconds { secs: 86400 },
        cooling_secs: HOUR,
    },
    active: P1,
    queued: Queued { policy: P3, effective_at: Instant { secs: 4600 } },
}
/// The same, queued for the last second, which never comes.
const STUCK: Rules = Rules {
    schedule: RAISING.schedule,
    active: P1,
    queued: Queued { policy: P3, effective_at: NEVER },
}

// A policy never loosens itself.
static_assert(!loosens(SHUT, to: SHUT))
static_assert(!loosens(OPEN, to: OPEN))
static_assert(!loosens(P1, to: P1))
static_assert(!loosens(P2, to: P2))
// `loosens` sees each field on its own, so the laws below are not vacuous.
static_assert(loosens(P1, to: P1_PAY) && !loosens(P1_PAY, to: P1))
static_assert(loosens(P1, to: P1_WINDOW) && !loosens(P1_WINDOW, to: P1))
static_assert(loosens(P1, to: P1_LATER) && !loosens(P1_LATER, to: P1))
static_assert(loosens(P1_PAUSED, to: P1) && !loosens(P1, to: P1_PAUSED))
static_assert(loosens(SHUT, to: OPEN) && !loosens(OPEN, to: SHUT))
static_assert(loosens(P1, to: P2) && loosens(P2, to: P1))

// `meet` is idempotent and never looser than either input.
static_assert(same(meet(P1, P1), P1))
static_assert(same(meet(SHUT, SHUT), SHUT))
static_assert(same(meet(OPEN, OPEN), OPEN))
static_assert(!loosens(P1, to: meet(P1, P2)) && !loosens(P2, to: meet(P1, P2)))
static_assert(!loosens(P1, to: meet(P1, P3)) && !loosens(P3, to: meet(P1, P3)))
static_assert(!loosens(P2, to: meet(P2, P3)) && !loosens(P3, to: meet(P2, P3)))
static_assert(same(meet(P1, OPEN), P1) && same(meet(OPEN, P1), P1))
static_assert(same(meet(P1, SHUT), SHUT) && same(meet(SHUT, P1), SHUT))
static_assert(same(meet(P1_PAY, P1), P1) && same(meet(P1, P1_WINDOW), P1))
static_assert(same(meet(P1_LATER, P1), P1) && same(meet(P1, P1_PAUSED), P1_PAUSED))

// The rule `amend` applies: a raise leaves the active policy as it was and
// is queued; a tightening applies at once and queues nothing; a mixed
// proposal tightens what it can now and queues the rest.
static_assert(same(meet(P1, P3), P1) && loosens(meet(P1, P3), to: P3))
static_assert(same(meet(P1, SHUT), SHUT) && !loosens(meet(P1, SHUT), to: SHUT))
static_assert(same(meet(P1, P1_PAUSED), P1_PAUSED) && !loosens(meet(P1, P1_PAUSED), to: P1_PAUSED))
static_assert(loosens(P1, to: P2) && loosens(meet(P1, P2), to: P2))
static_assert(!loosens(P1, to: meet(P1, P2)))

// `NOT_SET` and `NEVER` never take effect; any other moment does, from then on.
static_assert(!cooled(at: NOT_SET, now: NOT_SET) && !cooled(at: NOT_SET, now: NEVER))
static_assert(!cooled(at: NEVER, now: NOT_SET) && !cooled(at: NEVER, now: NEVER))
static_assert(!cooled(at: AT, now: AT - SECOND) && cooled(at: AT, now: AT))
static_assert(cooled(at: ONE, now: ONE) && cooled(at: ONE, now: NEVER))
// A queued policy is in force only once it has cooled.
static_assert(same(RAISING.current(now: AT), P1))
static_assert(same(RAISING.current(now: AT + HOUR - SECOND), P1))
static_assert(same(RAISING.current(now: AT + HOUR), P3))
static_assert(same(STUCK.current(now: NEVER), P1))
// `+` saturates at `NEVER`, which is what keeps a cooling period that runs
// past the end of time from ever ending.
static_assert(NEVER + HOUR == NEVER && ONE + FOREVER == NEVER)
static_assert(!cooled(at: ONE + FOREVER, now: NEVER))
static_assert(NOT_SET - HOUR == NOT_SET && AT - NEVER == NO_TIME)
