//! The HARDSTOP vault: the only place where money can move.
//!
//! The vault gathers facts (who is calling, is the recipient approved yet,
//! what time is it), hands them to the pure kernel, and does exactly what
//! the kernel decided. Money leaves in two ways only: to an approved
//! recipient on an `Allow` verdict, or back to the owner.
//!
//! Each handler's `uses` clause is its whole authority. `Pay` lists `active`,
//! `queued` and `approved_from` without `mut`, so the agent's code path
//! cannot change its own limits or its own recipients; the compiler rejects
//! a `Pay` that tries. `owner`, `agent`, `token` and `schedule` are
//! immutable: no handler can list them `mut`.
#![cfg(target = "evm")]

use std::evm::{Address, Call, Ctx, Log, StorageMap, revert_error}
use std::evm::erc20::safe_transfer
use ingot::kernel::{
    amend,
    cancel,
    cooled,
    decide,
    exposure,
    left_in_window,
    matures_at,
    Decision,
    Instant,
    Ledger,
    Policy,
    Queued,
    Reason,
    Request,
    Rules,
    Schedule,
    Seconds,
}

pub msg VaultMsg {
    // The agent's only door.
    #[selector = sol("pay(address,uint256,uint64)")]
    Pay { to: Address, amount: u256, nonce: u64 } -> u8,

    // Read-only: what would `pay` answer right now, and what would be left?
    // It answers for the rules only. It does not check that the vault holds
    // enough to make the transfer; an allowed `pay` reverts if it does not.
    #[selector = sol("preview(address,address,uint256,uint64)")]
    Preview { caller: Address, to: Address, amount: u256, nonce: u64 } -> (u8, u256),
    // Read-only: the most the rules let the agent move from now until
    // `until`. The vault's balance is a further limit this does not apply.
    #[selector = sol("exposure(uint64)")]
    Exposure { until: u64 } -> u256,

    // Owner only.
    #[selector = sol("propose(uint256,uint256,uint64,bool)")]
    Propose { per_payment: u256, per_window: u256, valid_until: u64, paused: bool },
    #[selector = sol("cancelQueued()")]
    CancelQueued,
    #[selector = sol("pause()")]
    Pause,
    #[selector = sol("setRecipient(address,bool)")]
    SetRecipient { who: Address, approved: bool },
    #[selector = sol("withdraw(uint256)")]
    Withdraw { amount: u256 },

    // Views.
    #[selector = sol("owner()")]
    Owner -> Address,
    #[selector = sol("agent()")]
    Agent -> Address,
    #[selector = sol("token()")]
    Token -> Address,
    // anchor, window_secs, cooling_secs
    #[selector = sol("schedule()")]
    ScheduleOf -> (u64, u64, u64),
    // The policy in force now: per_payment, per_window, valid_until, paused
    #[selector = sol("policy()")]
    PolicyOf -> (u256, u256, u64, bool),
    // The queued policy and when it takes effect (0: nothing queued)
    #[selector = sol("queued()")]
    QueuedOf -> (u256, u256, u64, bool, u64),
    // window, spent, next_nonce
    #[selector = sol("ledger()")]
    LedgerOf -> (u64, u256, u64),
    // The time from which `who` may be paid (0: not approved)
    #[selector = sol("approvedFrom(address)")]
    ApprovedFrom { who: Address } -> u64,
}

#[event]
pub struct Paid {
    #[indexed]
    nonce: u64,
    #[indexed]
    to: Address,
    amount: u256,
    left_in_window: u256,
}

#[event]
pub struct Blocked {
    #[indexed]
    nonce: u64,
    #[indexed]
    to: Address,
    amount: u256,
    code: u8,
    detail: u256,
}

/// `effective_at` is zero when the whole proposal applied at once.
#[event]
pub struct PolicyProposed {
    per_payment: u256,
    per_window: u256,
    valid_until: u64,
    paused: bool,
    effective_at: u64,
}

#[event]
pub struct QueueCancelled {}

/// `approved_from` is zero when the recipient was removed.
#[event]
pub struct RecipientChanged {
    #[indexed]
    who: Address,
    approved_from: u64,
}

#[event]
pub struct Withdrawn { amount: u256 }

#[error]
pub struct NotOwner {}

#[error]
pub struct NotAgent {}

#[error]
pub struct InvalidPolicy {}

/// The owner, the agent or the token was the zero address: a vault nobody
/// can control, an agent nobody holds, or a token that does not exist.
#[error]
pub struct ZeroAddress {}

fn only(_ allowed: Address, caller: Address) {
    if caller != allowed {
        revert_error(NotOwner {})
    }
}

fn seconds(_ at: Timestamp) -> Instant {
    Instant::at(at.as_seconds().downcast_saturate())
}

/// The shortest cooling period a vault may be created with. Anything
/// shorter is a ratchet in name only.
const MIN_COOLING_SECS: u64 = 60

pub contract Vault uses (ctx: Ctx, call: mut Call, log: mut Log) {
    owner: Address,
    agent: Address,
    token: Address,
    schedule: Schedule,
    mut active: Policy,
    mut queued: Queued,
    mut ledger: Ledger,
    mut approved_from: StorageMap<Address, Instant>,

    /// Recipients named here are approved from the first second. Everything
    /// added later waits out the cooling period.
    init(
        owner_: Address,
        agent_: Address,
        token_: Address,
        per_payment: u256,
        per_window: u256,
        valid_until: u64,
        window_secs: u64,
        cooling_secs: u64,
        payee_a: Address,
        payee_b: Address,
        payee_c: Address,
    )
    uses (
        ctx,
        mut owner,
        mut agent,
        mut token,
        mut schedule,
        mut active,
        mut queued,
        mut ledger,
        mut approved_from,
    )
    {
        if owner_ == Address::zero() || agent_ == Address::zero() || token_ == Address::zero() {
            revert_error(ZeroAddress {})
        }
        // A vault whose owner is also its agent has no owner-only controls,
        // and one with next to no cooling period has no ratchet.
        if window_secs == 0 || cooling_secs < MIN_COOLING_SECS || owner_ == agent_ {
            revert_error(InvalidPolicy {})
        }
        let now = seconds(ctx.timestamp())
        owner = owner_
        agent = agent_
        token = token_
        schedule = Schedule {
            anchor: now,
            window_secs: Seconds::of(window_secs),
            cooling_secs: Seconds::of(cooling_secs),
        }
        active = Policy {
            per_payment,
            per_window,
            valid_until: Instant::at(valid_until),
            paused: false,
        }
        queued = Queued::none()
        ledger = Ledger { window: 0, spent: 0, next_nonce: 0 }
        if payee_a != Address::zero() {
            approved_from.set(key: payee_a, value: now)
        }
        if payee_b != Address::zero() {
            approved_from.set(key: payee_b, value: now)
        }
        if payee_c != Address::zero() {
            approved_from.set(key: payee_c, value: now)
        }
    }

    recv VaultMsg {
        Pay { to, amount, nonce } -> u8 uses (
            ctx,
            agent,
            token,
            schedule,
            active,
            queued,
            approved_from,
            mut ledger,
            mut call,
            mut log,
        ) {
            let now = seconds(ctx.timestamp())
            let rules = Rules { schedule, active, queued }
            let request = Request {
                amount,
                nonce,
                from_agent: ctx.caller() == agent,
                to_approved: cooled(at: approved_from.get(key: to), now),
            }
            match decide(rules, ledger, request, now) {
                Decision::Allow(next) => {
                    // Ledger first, transfer second: a reentrant call sees the
                    // payment already counted, and a failed transfer reverts
                    // the whole transaction, ledger included.
                    ledger = next
                    safe_transfer(token, receiver: to, amount)
                    log.emit(
                        Paid {
                            nonce,
                            to,
                            amount,
                            left_in_window: left_in_window(rules.current(now), spent: next.spent),
                        },
                    )
                    0
                },
                Decision::Deny(reason) => {
                    match reason {
                        // Strangers get a revert, not a log entry.
                        Reason::NotAgent => revert_error(NotAgent {}),
                        _ => {},
                    }
                    log.emit(
                        Blocked { nonce, to, amount, code: reason.code(), detail: reason.detail() },
                    )
                    reason.code()
                },
            }
        }

        Preview { caller, to, amount, nonce } -> (u8, u256)
        uses (ctx, agent, schedule, active, queued, ledger, approved_from)
        {
            let now = seconds(ctx.timestamp())
            let rules = Rules { schedule, active, queued }
            let request = Request {
                amount,
                nonce,
                from_agent: caller == agent,
                to_approved: cooled(at: approved_from.get(key: to), now),
            }
            let decision = decide(rules, ledger, request, now)
            (decision.code(), decision.detail(policy: rules.current(now)))
        }

        Exposure { until } -> u256 uses (ctx, schedule, active, queued, ledger) {
            exposure(
                rules: Rules { schedule, active, queued },
                ledger,
                now: seconds(ctx.timestamp()),
                until: Instant::at(until),
            )
        }

        Propose { per_payment, per_window, valid_until, paused }
        uses (ctx, owner, schedule, mut active, mut queued, mut log)
        {
            only(owner, caller: ctx.caller())
            let proposed = Policy {
                per_payment,
                per_window,
                valid_until: Instant::at(valid_until),
                paused,
            }
            let next = amend(
                rules: Rules { schedule, active, queued },
                proposed,
                now: seconds(ctx.timestamp()),
            )
            active = next.active
            queued = next.queued
            log.emit(
                PolicyProposed {
                    per_payment,
                    per_window,
                    valid_until,
                    paused,
                    effective_at: next.queued.effective_at.secs(),
                },
            )
        }

        CancelQueued uses (ctx, owner, schedule, mut active, mut queued, mut log) {
            only(owner, caller: ctx.caller())
            let next = cancel(
                rules: Rules { schedule, active, queued },
                now: seconds(ctx.timestamp()),
            )
            active = next.active
            queued = next.queued
            log.emit(QueueCancelled {})
        }

        Pause uses (ctx, owner, schedule, mut active, mut queued, mut log) {
            only(owner, caller: ctx.caller())
            let now = seconds(ctx.timestamp())
            let rules = Rules { schedule, active, queued }
            var stopped = rules.current(now)
            stopped.paused = true
            let next = amend(rules, proposed: stopped, now)
            active = next.active
            queued = next.queued
            log.emit(
                PolicyProposed {
                    per_payment: stopped.per_payment,
                    per_window: stopped.per_window,
                    valid_until: stopped.valid_until.secs(),
                    paused: true,
                    effective_at: 0,
                },
            )
        }

        SetRecipient { who, approved } uses (ctx, owner, schedule, mut approved_from, mut log) {
            only(owner, caller: ctx.caller())
            let from = if !approved {
                Instant::at(0)
            } else if approved_from.get(key: who) != Instant::at(0) {
                // Already approved or already cooling: asking again does not restart the wait.
                approved_from.get(key: who)
            } else {
                matures_at(schedule, now: seconds(ctx.timestamp()))
            }
            approved_from.set(key: who, value: from)
            log.emit(RecipientChanged { who, approved_from: from.secs() })
        }

        Withdraw { amount } uses (ctx, owner, token, mut call, mut log) {
            only(owner, caller: ctx.caller())
            safe_transfer(token, receiver: owner, amount)
            log.emit(Withdrawn { amount })
        }

        Owner -> Address uses (owner) {
            owner
        }
        Agent -> Address uses (agent) {
            agent
        }
        Token -> Address uses (token) {
            token
        }

        ScheduleOf -> (u64, u64, u64) uses (schedule) {
            (schedule.anchor.secs(), schedule.window_secs.secs(), schedule.cooling_secs.secs())
        }

        PolicyOf -> (u256, u256, u64, bool) uses (ctx, schedule, active, queued) {
            let policy = Rules { schedule, active, queued }.current(now: seconds(ctx.timestamp()))
            (policy.per_payment, policy.per_window, policy.valid_until.secs(), policy.paused)
        }

        QueuedOf -> (u256, u256, u64, bool, u64) uses (ctx, queued) {
            if queued.matured(now: seconds(ctx.timestamp())) {
                // Already in force; `policy()` reports it.
                (0, 0, 0, false, 0)
            } else {
                (
                    queued.policy.per_payment,
                    queued.policy.per_window,
                    queued.policy.valid_until.secs(),
                    queued.policy.paused,
                    queued.effective_at.secs(),
                )
            }
        }

        LedgerOf -> (u64, u256, u64) uses (ledger) {
            (ledger.window, ledger.spent, ledger.next_nonce)
        }

        ApprovedFrom { who } -> u64 uses (approved_from) {
            approved_from.get(key: who).secs()
        }
    }
}
