//! The HARDSTOP vault: the only place where money can move.
//!
//! The vault gathers facts (who is calling, is the recipient approved yet,
//! what time is it), hands them to the pure kernel, and does exactly what
//! the kernel decided. Money leaves in two ways only: to an approved
//! recipient on an `Allow` verdict, or back to the owner.
//!
//! Each handler's `uses` clause is its whole authority over storage. `Pay`
//! lists `terms` and `approved_from` without `mut`, so the agent's code path
//! cannot change its own limits or its own recipients; the compiler rejects
//! a `Pay` that tries. `owner`, `agent` and `token` are immutable: no handler
//! can list them `mut`.
//!
//! The rules are stored as `Terms` (`kernel::sealed`), whose field this file
//! cannot see. A handler that lists `mut terms` can store only terms the
//! kernel made: from `open`, which works only while the vault is being
//! deployed, or from `Terms::amend`, `cancel` and `pause`, which apply the
//! kernel's cooling period. Hand-built terms, a hand-built `Rules` and a
//! written field do not compile.
//!
//! Those three methods, `Terms::approve_from`, `Seat::replace` and
//! `withdraw` take an `OwnerCall`. Only `prove` makes one: it compares the stored `Owner`
//! (which only `open` makes) with the caller read from `ctx`, passed as the
//! concrete `Evm`, so a stand-in context does not compile. Drop a handler's
//! `only` line and it has no proof to pass, so it does not compile either.
//!
//! The recipient map stores `Approval`s (`kernel::sealed`) too. A handler
//! that lists `mut approved_from` can store only approvals the kernel made:
//! from `founding`, which works only while the vault is being deployed, or
//! from `Terms::approve_from`, which takes an `OwnerCall` and applies the
//! cooling period. A hand-written date does not compile, and an approval
//! copied under another address approves no one.
//!
//! `Pay` holds no transfer of its own. `Books::judge` (`kernel::sealed`)
//! judges the payment from sealed inputs, counts it, and returns a sealed,
//! use-once `Payout` for that recipient and that amount; a hand-made one
//! does not compile.
//!
//! Not the compiler's: which address `init` gives `open` (the source check
//! in `scripts/pay-cannot-loosen.sh` pins it to `owner_` and `agent_`), the
//! token `Pay` hands `judge` (a plain address; the source check pins it to
//! the stored `token`), and a transfer imported into this file beside the
//! payout, which compiles: Fe cannot forbid an import, and any mutable
//! effect here can be rebound as `Call`. The source check refuses any
//! transfer in this file; tests catch one too.
#![cfg(target = "evm")]

use std::evm::{Address, Call, Ctx, Evm, Log, StorageMap, revert_error}
use ingot::kernel::{
    cooled,
    decide,
    exposure,
    left_in_window,
    Decision,
    Instant,
    Ledger,
    Policy,
    Reason,
    Request,
    Schedule,
    Seconds,
}
use ingot::kernel::sealed::{
    founding,
    moment,
    open,
    prove,
    withdraw,
    Approval,
    Books,
    Owner,
    OwnerCall,
    Seat,
    Terms,
    Verdict,
}

pub msg VaultMsg {
    // The agent's only door.
    #[selector = sol("pay(address,uint256,uint64)")]
    Pay { to: Address, amount: u256, nonce: u64 } -> u8,

    // Read-only: what would `pay` answer right now, and what would be left?
    // It answers for the rules only. It does not check that the vault holds
    // enough to make the transfer; an allowed `pay` reverts if it does not.
    #[selector = sol("preview(address,address,uint256,uint64)")]
    Preview { caller: Address, to: Address, amount: u256, nonce: u64 } -> (u8, u256),
    // Read-only: the most the rules let the agent move from now until
    // `until`. The vault's balance is a further limit this does not apply.
    #[selector = sol("exposure(uint64)")]
    Exposure { until: u64 } -> u256,

    // Owner only.
    #[selector = sol("propose(uint256,uint256,uint64,bool)")]
    Propose { per_payment: u256, per_window: u256, valid_until: u64, paused: bool },
    #[selector = sol("cancelQueued()")]
    CancelQueued,
    #[selector = sol("pause()")]
    Pause,
    #[selector = sol("setRecipient(address,bool)")]
    SetRecipient { who: Address, approved: bool },
    #[selector = sol("withdraw(uint256)")]
    Withdraw { amount: u256 },
    // Replace the agent's key: the old key stops at once, the new one starts
    // after the cooling period. The zero address leaves no agent.
    #[selector = sol("setAgent(address)")]
    SetAgent { who: Address },

    // Views.
    #[selector = sol("owner()")]
    Owner -> Address,
    // The key that may pay now (zero while a replacement waits).
    #[selector = sol("agent()")]
    Agent -> Address,
    // The replacement key waiting, and when it takes over (zero: none).
    #[selector = sol("nextAgent()")]
    NextAgent -> (Address, u64),
    #[selector = sol("token()")]
    Token -> Address,
    // anchor, window_secs, cooling_secs
    #[selector = sol("schedule()")]
    ScheduleOf -> (u64, u64, u64),
    // The policy in force now: per_payment, per_window, valid_until, paused
    #[selector = sol("policy()")]
    PolicyOf -> (u256, u256, u64, bool),
    // The queued policy and when it takes effect (0: nothing queued)
    #[selector = sol("queued()")]
    QueuedOf -> (u256, u256, u64, bool, u64),
    // window, spent, next_nonce
    #[selector = sol("ledger()")]
    LedgerOf -> (u64, u256, u64),
    // The time from which `who` may be paid (0: not approved)
    #[selector = sol("approvedFrom(address)")]
    ApprovedFrom { who: Address } -> u64,
}

#[event]
pub struct Paid {
    #[indexed]
    nonce: u64,
    #[indexed]
    to: Address,
    amount: u256,
    left_in_window: u256,
}

#[event]
pub struct Blocked {
    #[indexed]
    nonce: u64,
    #[indexed]
    to: Address,
    amount: u256,
    code: u8,
    detail: u256,
}

/// `effective_at` is zero when the whole proposal applied at once.
#[event]
pub struct PolicyProposed {
    per_payment: u256,
    per_window: u256,
    valid_until: u64,
    paused: bool,
    effective_at: u64,
}

#[event]
pub struct QueueCancelled {}

/// `approved_from` is zero when the recipient was removed.
#[event]
pub struct RecipientChanged {
    #[indexed]
    who: Address,
    approved_from: u64,
}

#[event]
pub struct Withdrawn { amount: u256 }

/// `from` is when `next` may start paying; the old key stopped at once.
#[event]
pub struct AgentChanged {
    #[indexed]
    next: Address,
    from: u64,
}

#[error]
pub struct NotOwner {}

#[error]
pub struct NotAgent {}

#[error]
pub struct InvalidPolicy {}

/// The owner, the agent or the token was the zero address: a vault nobody
/// can control, an agent nobody holds, or a token that does not exist.
#[error]
pub struct ZeroAddress {}

/// Reverts with `NotOwner` unless the caller of this call is `owner`;
/// otherwise the proof every rule-changing kernel function asks for.
fn only(_ owner: Owner, ctx: Evm) -> OwnerCall {
    match prove(owner, ctx) {
        Option::Some(proof) => proof,
        Option::None => revert_error(NotOwner {}),
    }
}

/// `who` approved from now, for a recipient the vault is created with.
fn founded(_ ctx: Evm, who: Address) -> Approval {
    match founding(ctx, who) {
        Option::Some(approval) => approval,
        Option::None => revert_error(InvalidPolicy {}),
    }
}

fn seconds(_ at: Timestamp) -> Instant {
    Instant::at(at.as_seconds().downcast_saturate())
}

/// The shortest cooling period a vault may be created with. Anything
/// shorter is a ratchet in name only.
const MIN_COOLING_SECS: u64 = 60

pub contract Vault uses (ctx: Ctx, call: mut Call, log: mut Log) {
    owner: Owner,
    mut seat: Seat,
    token: Address,
    mut terms: Terms,
    mut ledger: Books,
    mut approved_from: StorageMap<Address, Approval>,

    /// Recipients named here are approved from the first second. Everything
    /// added later waits out the cooling period.
    init(
        owner_: Address,
        agent_: Address,
        token_: Address,
        per_payment: u256,
        per_window: u256,
        valid_until: u64,
        window_secs: u64,
        cooling_secs: u64,
        payee_a: Address,
        payee_b: Address,
        payee_c: Address,
    )
    uses (ctx, mut owner, mut seat, mut token, mut terms, mut ledger, mut approved_from)
    {
        if owner_ == Address::zero() || agent_ == Address::zero() || token_ == Address::zero() {
            revert_error(ZeroAddress {})
        }
        // A vault whose owner is also its agent has no owner-only controls,
        // and one with next to no cooling period has no ratchet.
        if window_secs == 0 || cooling_secs < MIN_COOLING_SECS || owner_ == agent_ {
            revert_error(InvalidPolicy {})
        }
        let now = seconds(ctx.timestamp())
        let (owner_of, seat_of, terms_of, books_of) = match open(
            ctx,
            owner: owner_,
            agent: agent_,
            token: token_,
            schedule: Schedule {
                anchor: now,
                window_secs: Seconds::of(window_secs),
                cooling_secs: Seconds::of(cooling_secs),
            },
            policy: Policy {
                per_payment,
                per_window,
                valid_until: Instant::at(valid_until),
                paused: false,
            },
        ) {
            Option::Some(opened) => opened,
            Option::None => revert_error(InvalidPolicy {}),
        }
        owner = owner_of
        seat = seat_of
        token = token_
        terms = terms_of
        ledger = books_of
        if payee_a != Address::zero() {
            approved_from.set(key: payee_a, value: founded(ctx, who: payee_a))
        }
        if payee_b != Address::zero() {
            approved_from.set(key: payee_b, value: founded(ctx, who: payee_b))
        }
        if payee_c != Address::zero() {
            approved_from.set(key: payee_c, value: founded(ctx, who: payee_c))
        }
    }

    recv VaultMsg {
        Pay { to, amount, nonce } -> u8 uses (
            ctx,
            seat,
            terms,
            approved_from,
            mut ledger,
            mut call,
            mut log,
        ) {
            // The kernel judges the payment and counts it before anything
            // moves; the payout it returns can pay only `to`, only `amount`.
            let rules = terms.now()
            let agent = seat.now(ctx)
            let approval = approved_from.get(key: to)
            let at = moment(ctx)
            let verdict = ledger.judge(at, terms: rules, seat: agent, approval, to, amount, nonce)
            match verdict {
                Verdict::Pay(payout) => {
                    payout.send()
                    let now = seconds(ctx.timestamp())
                    log.emit(
                        Paid {
                            nonce,
                            to,
                            amount,
                            left_in_window: left_in_window(
                                terms.rules().current(now),
                                spent: ledger.ledger().spent,
                            ),
                        },
                    )
                    0
                },
                Verdict::Refuse(reason) => {
                    match reason {
                        // Strangers get a revert, not a log entry.
                        Reason::NotAgent => revert_error(NotAgent {}),
                        _ => {},
                    }
                    log.emit(
                        Blocked { nonce, to, amount, code: reason.code(), detail: reason.detail() },
                    )
                    reason.code()
                },
            }
        }

        Preview { caller, to, amount, nonce } -> (u8, u256)
        uses (ctx, seat, terms, ledger, approved_from)
        {
            let now = seconds(ctx.timestamp())
            let rules = terms.rules()
            let agent = seat.agent_at(now)
            let request = Request {
                amount,
                nonce,
                from_agent: agent != Address::zero() && caller == agent,
                to_approved: cooled(at: approved_from.get(key: to).of(to), now),
            }
            let decision = decide(rules, ledger: ledger.ledger(), request, now)
            (decision.code(), decision.detail(policy: rules.current(now)))
        }

        Exposure { until } -> u256 uses (ctx, terms, ledger) {
            exposure(
                rules: terms.rules(),
                ledger: ledger.ledger(),
                now: seconds(ctx.timestamp()),
                until: Instant::at(until),
            )
        }

        Propose { per_payment, per_window, valid_until, paused }
        uses (ctx, owner, mut terms, mut log)
        {
            let proof = only(owner, ctx)
            let proposed = Policy {
                per_payment,
                per_window,
                valid_until: Instant::at(valid_until),
                paused,
            }
            terms.amend(proof, proposed)
            log.emit(
                PolicyProposed {
                    per_payment,
                    per_window,
                    valid_until,
                    paused,
                    effective_at: terms.rules().queued.effective_at.secs(),
                },
            )
        }

        CancelQueued uses (ctx, owner, mut terms, mut log) {
            let proof = only(owner, ctx)
            terms.cancel(proof)
            log.emit(QueueCancelled {})
        }

        Pause uses (ctx, owner, mut terms, mut log) {
            let proof = only(owner, ctx)
            terms.pause(proof)
            let stopped = terms.rules().active
            log.emit(
                PolicyProposed {
                    per_payment: stopped.per_payment,
                    per_window: stopped.per_window,
                    valid_until: stopped.valid_until.secs(),
                    paused: stopped.paused,
                    effective_at: 0,
                },
            )
        }

        SetRecipient { who, approved } uses (ctx, owner, terms, mut approved_from, mut log) {
            let proof = only(owner, ctx)
            let from = terms
                .approve_from(proof, who, current: approved_from.get(key: who), approved)
            approved_from.set(key: who, value: from)
            log.emit(
                RecipientChanged { who, approved_from: from.of(who).secs() },
            )
        }

        Withdraw { amount } uses (ctx, owner, ledger, mut call, mut log) {
            let proof = only(owner, ctx)
            let token = ledger.token()
            withdraw(proof, owner, token, amount)
            log.emit(Withdrawn { amount })
        }

        SetAgent { who } uses (ctx, owner, terms, mut seat, mut log) {
            let proof = only(owner, ctx)
            if !seat.replace(proof, terms, owner, who) {
                // Naming the owner as the agent would leave a leaked key working.
                revert_error(InvalidPolicy {})
            }
            let (next, from) = seat.waiting(now: seconds(ctx.timestamp()))
            log.emit(AgentChanged { next, from: from.secs() })
        }

        Owner -> Address uses (owner) {
            owner.address()
        }
        Agent -> Address uses (ctx, seat) {
            seat.agent_at(now: seconds(ctx.timestamp()))
        }

        NextAgent -> (Address, u64) uses (ctx, seat) {
            let (next, from) = seat.waiting(now: seconds(ctx.timestamp()))
            (next, from.secs())
        }
        Token -> Address uses (ledger) {
            ledger.token()
        }

        ScheduleOf -> (u64, u64, u64) uses (terms) {
            let schedule = terms.rules().schedule
            (schedule.anchor.secs(), schedule.window_secs.secs(), schedule.cooling_secs.secs())
        }

        PolicyOf -> (u256, u256, u64, bool) uses (ctx, terms) {
            let policy = terms.rules().current(now: seconds(ctx.timestamp()))
            (policy.per_payment, policy.per_window, policy.valid_until.secs(), policy.paused)
        }

        QueuedOf -> (u256, u256, u64, bool, u64) uses (ctx, terms) {
            let queued = terms.rules().queued
            if queued.matured(now: seconds(ctx.timestamp())) {
                // Already in force; `policy()` reports it.
                (0, 0, 0, false, 0)
            } else {
                (
                    queued.policy.per_payment,
                    queued.policy.per_window,
                    queued.policy.valid_until.secs(),
                    queued.policy.paused,
                    queued.effective_at.secs(),
                )
            }
        }

        LedgerOf -> (u64, u256, u64) uses (ledger) {
            let books = ledger.ledger()
            (books.window, books.spent, books.next_nonce)
        }

        ApprovedFrom { who } -> u64 uses (approved_from) {
            approved_from.get(key: who).of(who).secs()
        }
    }
}
